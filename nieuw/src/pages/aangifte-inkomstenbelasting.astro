---
import Basis from '../layouts/Basis.astro';
import Paginakop from '../components/Paginakop.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Faq from '../components/Faq.astro';
import Contactblok from '../components/Contactblok.astro';

const faq: [string, string][] = [
  ['Wat kost het laten doen van mijn aangifte inkomstenbelasting?', '€245 excl. btw voor één persoon, of €395 samen met je fiscale partner. Was je het hele jaar klant voor je boekhouding, dan krijg je 15% korting.'],
  ['Heb je mijn DigiD nodig?', 'Nee. Ik dien je aangifte in via mijn eigen beveiligde aansluiting als boekhouder. Jij geeft alleen akkoord op het concept.'],
  ['Wanneer moet de aangifte binnen zijn?', 'Uiterlijk 1 mei van het jaar erna. Lever je je gegevens op tijd aan, dan zorg ik dat het lukt. Met uitstel heb je tot 1 september, maar dan kan er belastingrente bijkomen.'],
  ['Wat als ik uitstel heb?', 'Vraag je zelf uitstel aan vóór 1 mei, dan heb je tot 1 september. Let wel op: moet je bijbetalen, dan rekent de Belastingdienst belastingrente vanaf 1 juli. Dien je vóór 1 mei in en neemt de Belastingdienst je aangifte over zoals hij is, dan betaal je geen belastingrente. Moet je bijbetalen, lever dan liever vroeg aan.'],
  ['Wat kost belastingrente?', 'Belastingrente loopt vanaf 1 juli tot zes weken na de datum op je aanslag. Hoe later je aangifte binnen is, hoe later de aanslag komt en hoe meer rente je betaalt. Daarom plan ik aangiftes met een bijbetaling zo vroeg mogelijk.'],
  ['Wat als mijn situatie ingewikkelder is?', 'Bij bijvoorbeeld een emigratiejaar, de verkoop van een woning of aandelen in een bv kijk ik eerst wat er nodig is. Je hoort de prijs voordat ik begin.'],
  ['Hoe lever ik mijn gegevens aan?', 'Je krijgt een vaste link naar een korte vragenlijst, waar je ook je stukken uploadt. Mis ik iets, dan vraag ik het je.'],
];
const service = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: 'Aangifte inkomstenbelasting',
  serviceType: 'Belastingaangifte',
  provider: { '@type': 'AccountingService', name: 'Slim Geregeld Administratie', url: 'https://slim-geregeld.nl/' },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  offers: [
    { '@type': 'Offer', name: 'Eén persoon', price: '245', priceCurrency: 'EUR', description: 'Exclusief btw' },
    { '@type': 'Offer', name: 'Met fiscale partner', price: '395', priceCurrency: 'EUR', description: 'Exclusief btw' },
  ],
};
---
<Basis
  titel="Aangifte inkomstenbelasting laten doen | €245 | Slim Geregeld"
  omschrijving="Je aangifte inkomstenbelasting laten doen door een Becon-geregistreerd boekhouder: €245 excl. btw, €395 met partner. Eerst een concept, geen DigiD nodig."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(service)} />
  <Paginakop
    kruimel="Aangifte inkomstenbelasting"
    tag="Aangifte IB"
    titel="Je aangifte inkomstenbelasting, goed en op tijd"
    sub="Ik doe je aangifte, loop je aftrekposten na en stuur je eerst een concept. Pas na jouw akkoord dien ik hem in. Je DigiD heb ik niet nodig."
    prijs={{ bedrag: '€245', per: 'per aangifte, excl. btw', uitleg: '€395 samen met je fiscale partner · klant? 15% korting' }}
    knop={['Aangifte laten doen', '#contact']}
    foto={false}
  />

  <section style="padding-top:8px">
    <div class="wrap">
      <h2>Zo werkt het</h2>
      <div class="grid3 vier">
        <div class="blok"><div class="nr">1</div><h3>Vragenlijst</h3><p>Je krijgt een vaste link. Daar vul je een korte vragenlijst in en upload je je stukken.</p></div>
        <div class="blok"><div class="nr">2</div><h3>Ik maak het concept</h3><p>Ik vul de aangifte in en loop je aftrekposten na. Mis ik iets, dan vraag ik het je.</p></div>
        <div class="blok"><div class="nr">3</div><h3>Jij geeft akkoord</h3><p>Je krijgt het concept met de uitkomst: wat je terugkrijgt of moet betalen.</p></div>
        <div class="blok"><div class="nr">4</div><h3>Ik dien hem in</h3><p>Pas na jouw akkoord gaat de aangifte naar de Belastingdienst.</p></div>
      </div>
    </div>
  </section>

  <section class="zacht">
    <div class="wrap">
      <div class="twee boven">
        <div>
          <h2>Voor iedereen die aangifte moet doen</h2>
          <p class="sub">Ondernemer, DGA, in loondienst of samen met je partner: ik doe je aangifte. Heb je een eigen bedrijf maar geen boekhouding bij mij? Dan lever je je jaarcijfers aan, of maak ik een financieel jaaroverzicht voor je, vanaf €395.</p>
        </div>
        <div>
          <h2>Wat ik nakijk</h2>
          <ul class="vinkjes kolom2">
            <li>Zelfstandigenaftrek en startersaftrek</li>
            <li>Mkb-winstvrijstelling</li>
            <li>Investeringsaftrek (KIA)</li>
            <li>Urencriterium</li>
            <li>Heffingskortingen</li>
            <li>Verdeling met je fiscale partner</li>
            <li>Eigen woning en hypotheekrente</li>
            <li>Sparen en beleggen in box 3</li>
            <li>Aanmerkelijk belang in box 2</li>
            <li>Lijfrente en jaarruimte</li>
            <li>Giften en zorgkosten</li>
            <li>Je voorlopige aanslag</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <GoogleReviews eerst={['Dany Cramer', 'Benthe Lokhorst']} />
    </div>
  </section>

  <Faq vragen={faq} />
  <Contactblok titel="Aangifte laten doen" tekst="Laat je gegevens achter, dan stuur ik je binnen een tot drie werkdagen de link naar de vragenlijst." vinkjes={['Eerst een concept, dan pas indienen', 'Geen DigiD nodig', 'Vaste prijs, vooraf bekend']} />
</Basis>

<style>
@media (min-width:1000px){.grid3.vier{grid-template-columns:repeat(4,1fr)}}
.boven{align-items:start}
.kolom2{gap:8px 18px}
@media (min-width:560px){.kolom2{grid-template-columns:1fr 1fr}}
</style>

---
import Basis from '../../layouts/Basis.astro';
---
<Basis
  titel="Thank you for your message | Slim Geregeld"
  omschrijving="Your message is in. You get an answer within one to three working days."
  taal="en"
  robots="noindex, follow"
  cta="/daft/contact/"
>
  <section class="dank">
    <div class="wrap">
      <img class="foto" src="/img/kyle-profiel.jpg" alt="Kyle Bouwmeester" width="88" height="88">
      <h1>Thank you, your message is in</h1>
      <p class="sub">You get an answer from me within one to three working days, usually the same day. In a hurry? Send me a WhatsApp.</p>
      <div class="knoppen">
        <a class="knop wa" href="https://wa.me/31621311043" target="_blank" rel="noopener">Send a WhatsApp</a>
        <a class="knop leeg" href="/en/">Back to the homepage</a>
      </div>
    </div>
  </section>
</Basis>

<script is:inline>
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ event: 'formulier_verstuurd', formulier: new URLSearchParams(location.search).get('formulier') || 'contact-en' });
</script>

<style>
.dank{padding:64px 0 80px;text-align:center;background:linear-gradient(180deg,var(--blauw-t),#fff 75%)}
.foto{width:88px;height:88px;border-radius:50%;object-fit:cover;margin:0 auto 18px;box-shadow:var(--schaduw)}
.sub{margin:14px auto 24px}
.knoppen{justify-content:center}
</style>

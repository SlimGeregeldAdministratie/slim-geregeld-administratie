---
import AuteurPagina from '../../../components/AuteurPagina.astro';
import { AUTEURPADEN } from '../../../lib/inhoud.mjs';
export function getStaticPaths() {
  return Object.entries(AUTEURPADEN).map(([sleutel, p]: any) => ({ params: { auteur: p.en.split('/')[3] }, props: { sleutel } }));
}
---
<AuteurPagina sleutel={Astro.props.sleutel} taal="en" />

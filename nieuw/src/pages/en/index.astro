---
/* Verdragspagina in de nieuwe huisstijl. De inhoud en het formulier zijn letterlijk
   overgenomen van de oude pagina (src/inhoud/en.html), zodat de koppeling met
   n8n blijft werken. Kop, voet en meting komen uit Basis. */
import Basis from '../../layouts/Basis.astro';
import '../../styles/verdrag/en.css';
import '../../styles/verdrag.css';
import inhoud from '../../inhoud/en.html?raw';
import Bewijs from '../../components/Bewijs.astro';
import GoogleReviews from '../../components/GoogleReviews.astro';
const [voor, rest] = inhoud.split('<!--SCORES-->');
const [midden, na] = rest.split('<!--REVIEWS-->');
---
<Basis
  titel="DAFT and DJTT Bookkeeping in English | Slim Geregeld"
  omschrijving="Signed opening balance sheets, renewal statements and monthly bookkeeping in English for DAFT and DJTT entrepreneurs, by a Becon-registered bookkeeper."
  taal="en"
  cta="#choose"
>
  <script slot="head" type="application/ld+json" set:html={"{\n \"@context\": \"https://schema.org\",\n \"@graph\": [\n  {\n   \"@type\": [\n    \"AccountingService\",\n    \"ProfessionalService\"\n   ],\n   \"@id\": \"https://slim-geregeld.nl/#org\",\n   \"name\": \"Slim Geregeld Administratie\",\n   \"url\": \"https://slim-geregeld.nl/\",\n   \"email\": \"kyle@slim-geregeld.nl\",\n   \"telephone\": \"+31621311043\",\n   \"address\": {\n    \"@type\": \"PostalAddress\",\n    \"addressLocality\": \"Koog aan de Zaan\",\n    \"addressCountry\": \"NL\"\n   },\n   \"identifier\": {\n    \"@type\": \"PropertyValue\",\n    \"propertyID\": \"KVK\",\n    \"value\": \"92596991\"\n   },\n   \"knowsLanguage\": [\n    \"en\",\n    \"nl\"\n   ],\n   \"founder\": {\n    \"@id\": \"https://slim-geregeld.nl/#kyle\"\n   },\n   \"sameAs\": [\n    \"https://www.moneybird.nl/experts/slim-geregeld-administratie/\"\n   ]\n  },\n  {\n   \"@type\": \"Person\",\n   \"@id\": \"https://slim-geregeld.nl/#kyle\",\n   \"name\": \"Kyle Bouwmeester\",\n   \"jobTitle\": \"Becon-registered bookkeeper\",\n   \"worksFor\": {\n    \"@id\": \"https://slim-geregeld.nl/#org\"\n   }\n  },\n  {\n   \"@type\": \"WebSite\",\n   \"@id\": \"https://slim-geregeld.nl/#website\",\n   \"url\": \"https://slim-geregeld.nl/\",\n   \"name\": \"Slim Geregeld\",\n   \"publisher\": {\n    \"@id\": \"https://slim-geregeld.nl/#org\"\n   }\n  },\n  {\n   \"@type\": \"WebPage\",\n   \"@id\": \"https://slim-geregeld.nl/en/#webpage\",\n   \"url\": \"https://slim-geregeld.nl/en/\",\n   \"name\": \"Treaty services in English\",\n   \"inLanguage\": \"en\",\n   \"isPartOf\": {\n    \"@id\": \"https://slim-geregeld.nl/#website\"\n   },\n   \"description\": \"Opening balance sheets, renewal statements and monthly bookkeeping in English for US and Japanese entrepreneurs with a Dutch treaty residence permit (DAFT and DJTT).\",\n   \"breadcrumb\": {\n    \"@id\": \"https://slim-geregeld.nl/en/#breadcrumb\"\n   },\n   \"mainEntity\": {\n    \"@id\": \"https://slim-geregeld.nl/en/#diensten\"\n   },\n   \"dateModified\": \"2026-11-18\"\n  },\n  {\n   \"@type\": \"BreadcrumbList\",\n   \"@id\": \"https://slim-geregeld.nl/en/#breadcrumb\",\n   \"itemListElement\": [\n    {\n     \"@type\": \"ListItem\",\n     \"position\": 1,\n     \"name\": \"Slim Geregeld\",\n     \"item\": \"https://slim-geregeld.nl/\"\n    },\n    {\n     \"@type\": \"ListItem\",\n     \"position\": 2,\n     \"name\": \"English\",\n     \"item\": \"https://slim-geregeld.nl/en/\"\n    }\n   ]\n  },\n  {\n   \"@type\": \"ItemList\",\n   \"@id\": \"https://slim-geregeld.nl/en/#diensten\",\n   \"name\": \"Treaty services\",\n   \"itemListElement\": [\n    {\n     \"@type\": \"ListItem\",\n     \"position\": 1,\n     \"name\": \"DAFT, US citizens\",\n     \"url\": \"https://slim-geregeld.nl/daft/\"\n    },\n    {\n     \"@type\": \"ListItem\",\n     \"position\": 2,\n     \"name\": \"DJTT, Japanese nationals\",\n     \"url\": \"https://slim-geregeld.nl/djtt/\"\n    },\n    {\n     \"@type\": \"ListItem\",\n     \"position\": 3,\n     \"name\": \"Permit renewal\",\n     \"url\": \"https://slim-geregeld.nl/daft/renewal/\"\n    },\n    {\n     \"@type\": \"ListItem\",\n     \"position\": 4,\n     \"name\": \"Compliance Plan\",\n     \"url\": \"https://slim-geregeld.nl/daft/#pricing\"\n    }\n   ]\n  },\n  {\n   \"@type\": \"FAQPage\",\n   \"@id\": \"https://slim-geregeld.nl/en/#faq\",\n   \"inLanguage\": \"en\",\n   \"isPartOf\": {\n    \"@id\": \"https://slim-geregeld.nl/en/#webpage\"\n   },\n   \"mainEntity\": [\n    {\n     \"@type\": \"Question\",\n     \"name\": \"What is the difference between DAFT and DJTT?\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"DAFT is the Dutch-American Friendship Treaty, for US citizens, purpose 453 on the IND form. DJTT is the Dutch-Japanese Trade Treaty, for Japanese nationals, purpose 510. The requirements are the same: no points system, at least €4,500 of equity, and a balance sheet checked and signed by an authorised independent expert.\"\n     }\n    },\n    {\n     \"@type\": \"Question\",\n     \"name\": \"Do I need an accountant for a treaty permit?\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"You need an authorised independent external expert to check and sign your balance sheet. The IND names a registeraccountant, an accountant-administratieconsulent, a bookkeeper or a financial adviser, so a bookkeeper is enough. For the years after that, nobody is required to keep your books for you, but you do have to file VAT and income tax returns and keep your equity at €4,500 or more.\"\n     }\n    },\n    {\n     \"@type\": \"Question\",\n     \"name\": \"What does the whole process cost?\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"The signed opening balance sheet is €495 excluding VAT, or €595 within 48 hours. The renewal statement costs the same. The IND charges its own fee for the application, see the IND fees page. Monthly bookkeeping on the Compliance Plan is €79 or €149 a month excluding VAT, with the balance sheet and the renewal statement included.\"\n     }\n    },\n    {\n     \"@type\": \"Question\",\n     \"name\": \"Can I do this from outside the Netherlands?\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Everything that happens here is remote: you send your documents by email and receive the signed PDF. The KVK registration, the bank account and the IND application each have their own procedure.\"\n     }\n    },\n    {\n     \"@type\": \"Question\",\n     \"name\": \"Do you also file my US tax return?\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"No. Slim Geregeld handles the Dutch side: the balance sheet, the Dutch VAT and income tax returns and the renewal statement. For your US return you need a US tax preparer.\"\n     }\n    },\n    {\n     \"@type\": \"Question\",\n     \"name\": \"Is everything in English?\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"Yes, every page, email and document. The balance sheet itself is in Dutch and English side by side. There is also a Japanese page for the Japanese treaty, but all communication is in English.\"\n     }\n    }\n   ]\n  }\n ]\n}"} />
  <div class="verdrag v-en">
    <Fragment set:html={voor} /><Bewijs taal="en" /><Fragment set:html={midden} />
    <section class=""><div class="container"><GoogleReviews taal="en" eerst={['Barry Sims', 'Orlando Guerra']} /></div></section>
    <Fragment set:html={na} />
  </div>
</Basis>

---
import DownloadPagina from '../../../components/DownloadPagina.astro';
import { DOWNLOADS } from '../../../lib/inhoud.mjs';
export function getStaticPaths() {
  return DOWNLOADS.downloads.map((d: any) => ({ params: { slug: d.en.pad.split('/')[3] }, props: { d } }));
}
---
<DownloadPagina d={Astro.props.d} taal="en" />

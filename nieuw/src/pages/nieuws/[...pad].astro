---
// /nieuws: Kyles LinkedIn-posts als gewone tekst, uit content/nieuws/nieuws.json
// (de n8n-content-engine vult dat bestand). 10 per pagina, plus een pagina per
// onderwerp; een onderwerp met minder dan 3 posts staat op noindex.
import Basis from '../../layouts/Basis.astro';
import '../../styles/blog.css';
import { B, ONDERWERPEN, nieuwsPaden, alineas, datumMooi, youtubeId, blogVanNieuws, metKyle, kruimelGraaf, ld } from '../../lib/inhoud.mjs';
import { videoObject } from '../../lib/blog.mjs';
export function getStaticPaths() { return nieuwsPaden(); }
const { n, paginas, basis, cluster, aanwezig, index, items } = Astro.props as any;
const { perPagina, clusters } = ONDERWERPEN;
const label = cluster ? clusters[cluster] : null;
const pad = n === 1 ? basis : `${basis}${n}/`;
const u = B + pad;
const achter = n > 1 ? `, pagina ${n}` : '';
const titel = label ? `${label}: nieuws en tips${achter} | Slim Geregeld` : (n === 1 ? 'Nieuws en belastingtips voor ondernemers | Slim Geregeld' : `Nieuws en belastingtips${achter} | Slim Geregeld`);
const basisOmschrijving = 'Praktische tips over administratie, ondernemerschap en belastingen van boekhouder Kyle Bouwmeester.';
const omschrijving = label
  ? `Posts van boekhouder Kyle Bouwmeester over ${label.toLowerCase()}${n > 1 ? ` (pagina ${n} van ${paginas})` : ''}: praktische tips voor ondernemers.`
  : (n === 1 ? basisOmschrijving : `${basisOmschrijving} Pagina ${n} van ${paginas}.`);
const h1 = label ? `Nieuws over ${label.toLowerCase()}` : 'Nieuws en updates';
const vorige = n > 1 ? (n === 2 ? basis : `${basis}${n - 1}/`) : null;
const volgende = n < paginas ? `${basis}${n + 1}/` : null;
const nieuwste = items.reduce((m: string, x: any) => (x.datum > m ? x.datum : m), items[0]?.datum || '2026-11-01');
const kopVan = (x: any) => x.titel || alineas(x.tekst)[0].split('\n')[0];
const kruimels = [['Home', '/'], ['Nieuws', '/nieuws/'], ...(label ? [[label, basis]] : []), ...(n > 1 ? [[`Pagina ${n}`, pad]] : [])];
const graaf = [...metKyle('nl'),
  { '@type': 'CollectionPage', '@id': u + '#webpage', url: u, name: titel, description: omschrijving, inLanguage: 'nl', isPartOf: { '@id': B + '/#website' },
    publisher: { '@id': B + '/#org' }, breadcrumb: { '@id': u + '#breadcrumb' }, dateModified: nieuwste,
    mainEntity: { '@type': 'ItemList', itemListElement: items.map((x: any, i: number) => ({ '@type': 'ListItem', position: (n - 1) * perPagina + i + 1, item: {
      '@type': 'SocialMediaPosting', headline: kopVan(x).slice(0, 110), datePublished: x.datum, url: x.urlProfiel || x.urlPagina,
      author: { '@id': B + '/#kyle' }, publisher: { '@id': B + '/#org' }, inLanguage: x.taal || 'nl', about: clusters[x.cluster],
      ...(x.media?.type === 'carrousel' ? { image: x.media.paginas.map((q: string) => B + q) } : x.afbeelding ? { image: x.afbeelding } : {}),
      ...(x.media?.type === 'video' ? { video: videoObject(x, B) } : {}) } })) } },
  kruimelGraaf(u, kruimels)];
---
<Basis titel={titel} omschrijving={omschrijving} robots={index ? 'index, follow' : 'noindex, follow'} cta="/#contact">
  <script slot="head" type="application/ld+json" set:html={ld(graaf)} />
  {vorige && <link slot="head" rel="prev" href={B + vorige} />}
  {volgende && <link slot="head" rel="next" href={B + volgende} />}
  <section class="blog-kop">
    <div class="wrap">
      <span class="tag">Blog</span>
      <h1>{h1}</h1>
      <p class="sub">De posts van Kyle Bouwmeester op LinkedIn, als gewone tekst: praktische tips over administratie, btw, de BV en belastingen voor ondernemers.</p>
      {<nav class="blog-tabs" aria-label="Blog en nieuws"><a href="/blog/">Artikelen</a><a href="/nieuws/" aria-current="page">Nieuws en tips</a></nav>}
    </div>
  </section>
  <section style="padding-top:8px">
    <div class="wrap"><div style="max-width:820px">
      <nav class="blog-filters" aria-label="Onderwerp">
        <a href="/nieuws/" aria-current={!cluster ? 'page' : undefined}>Alle onderwerpen</a>
        {aanwezig.map((c: string) => <a href={`/nieuws/onderwerp/${c}/`} aria-current={cluster === c ? 'page' : undefined}>{clusters[c]}</a>)}
      </nav>
      <div class="blog-lijst">
        {items.map((x: any) => {
          const m = x.media;
          const yt = m?.type === 'video' ? youtubeId(m.src) : null;
          const blog = blogVanNieuws(x);
          return (
            <article class="nieuws-post" lang={x.taal && x.taal !== 'nl' ? x.taal : undefined}>
              <div class="blog-meta"><a class="blog-label" href={`/nieuws/onderwerp/${x.cluster}/`}>{clusters[x.cluster]}</a><time datetime={x.datum}>{datumMooi(x.datum, 'nl')}</time></div>
              <h2>{kopVan(x)}</h2>
              {m?.type === 'carrousel' && (
                <section aria-label="Carrousel" style="padding:0">
                  {m.paginas.map((q: string, i: number) => <figure><img src={q} alt={m.tekstPerPagina[i]} loading="lazy" decoding="async"><figcaption>Dia {i + 1} van {m.paginas.length}: {m.tekstPerPagina[i]}</figcaption></figure>)}
                  <p><a href={m.pdf} download>Download de carrousel (pdf)</a></p>
                </section>
              )}
              {m?.type === 'video' && (yt
                ? <iframe src={`https://www.youtube-nocookie.com/embed/${yt}`} title={kopVan(x)} width="560" height="315" loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen style="border:0"></iframe>
                : <video controls preload="none" poster={m.poster || undefined}><source src={m.src} type="video/mp4"></video>)}
              {alineas(x.tekst).map((a: string) => <p set:html={a.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '<br>')} />)}
              {x.afbeelding && !m && <img class="nieuws-foto" src={x.afbeelding} alt={kopVan(x)} loading="lazy" decoding="async" onerror="this.remove()">}
              {m?.type === 'video' && <><h3 style="margin-top:14px">Transcript</h3>{alineas(m.transcript).map((a: string) => <p>{a}</p>)}</>}
              <p class="nieuws-links">
                <a href={x.urlProfiel || x.urlPagina} rel="noopener">Bekijk op LinkedIn</a>
                {x.urlPagina && x.urlProfiel && <a href={x.urlPagina} rel="noopener">Bekijk op de bedrijfspagina</a>}
                {blog && <a href={blog}>Lees het hele stuk</a>}
              </p>
            </article>
          );
        })}
      </div>
      {paginas > 1 && (
        <nav class="blog-pag" aria-label="Paginering">
          {vorige ? <a href={vorige} rel="prev">← Vorige</a> : <span></span>}
          <span>Pagina {n} van {paginas}</span>
          {volgende ? <a href={volgende} rel="next">Volgende →</a> : <span></span>}
        </nav>
      )}
      <p style="margin-top:28px"><a class="knop leeg" href="/blog/">Lees ook de blog</a></p>
</div>
    </div>
  </section>
</Basis>

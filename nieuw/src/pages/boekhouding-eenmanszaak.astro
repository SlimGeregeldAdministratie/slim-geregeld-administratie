---
import Basis from '../layouts/Basis.astro';
import Paginakop from '../components/Paginakop.astro';
import SlimGesprek from '../components/SlimGesprek.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Faq from '../components/Faq.astro';
import Contactblok from '../components/Contactblok.astro';

const faq: [string, string][] = [
  ['Wat kost een boekhouder voor een eenmanszaak?', 'Bij mij €95 per maand excl. btw, met je boekhouding, de btw-aangiftes en je jaarcijfers erbij. Je aangifte inkomstenbelasting is los: €245, met 15% korting als je het hele jaar klant was.'],
  ['Geldt dit ook voor een vof?', 'Ja. Voor een vof doe ik de boekhouding en btw van de vof, en de jaarcijfers met de winstverdeling per vennoot. De aangifte IB is per vennoot.'],
  ['Ik start net. Kan ik al bij je terecht?', 'Ja. Ik richt je administratie meteen goed in, zodat je vanaf je eerste factuur op orde bent. Dan weet je ook meteen of je btw moet rekenen.'],
  ['Kan ik midden in het jaar overstappen?', 'Ja. Ik neem je administratie over vanaf het moment dat het past en zet de rest van het jaar recht.'],
  ['Wat moet ik zelf nog doen?', 'Je facturen maken (of laten maken door Slim), je bonnetjes appen en je bank één keer koppelen aan Moneybird. De rest doe ik.'],
  ['Wat kost Moneybird?', 'Moneybird staat op jouw naam en kost meestal €15 tot €35 per maand, afhankelijk van hoeveel banktransacties je hebt. Via mijn link heb je de eerste 120 dagen gratis, in plaats van 60.'],
  ['Heb ik een aparte zakelijke rekening nodig?', 'Het hoeft niet, maar het maakt je boekhouding een stuk overzichtelijker en dus ook sneller. Ik raad het aan.'],
];
const service = {
  '@context': 'https://schema.org', '@type': 'Service',
  name: 'Boekhouding voor eenmanszaak en vof',
  serviceType: 'Boekhouding',
  provider: { '@type': 'AccountingService', name: 'Slim Geregeld Administratie', url: 'https://slim-geregeld.nl/' },
  areaServed: { '@type': 'Country', name: 'Nederland' },
  offers: { '@type': 'Offer', price: '95', priceCurrency: 'EUR', description: 'Per maand, exclusief btw' },
};
---
<Basis
  titel="Boekhouder eenmanszaak en vof | €95 per maand | Slim Geregeld"
  omschrijving="Boekhouding, btw-aangifte per kwartaal en jaarcijfers voor je eenmanszaak of vof, in Moneybird, voor €95 per maand excl. btw. Bonnetjes stuur je via WhatsApp."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(service)} />
  <Paginakop
    kruimel="Boekhouding eenmanszaak"
    tag="Eenmanszaak en vof"
    titel="Boekhouding voor je eenmanszaak, zonder gedoe"
    sub="Ik doe je boekhouding in Moneybird, je btw-aangifte elk kwartaal en je jaarcijfers. Jij appt je bonnetjes en houdt je avonden vrij."
    prijs={{ bedrag: '€95', oud: '€125', per: 'per maand, excl. btw', uitleg: 'volledige service, Moneybird op je eigen naam' }}
    foto={{ src: '/img/kyle-1.jpg', alt: 'Kyle Bouwmeester op de bank met zijn laptop', pos: '50% 40%' }}
  />

  <section>
    <div class="wrap">
      <h2>Voor wie?</h2>
      <div class="grid3 vier">
        <div class="blok"><h3>Zzp'ers die het zat zijn</h3><p>Je doet het nu zelf, maar elke btw-deadline kost je een avond en je weet nooit zeker of het klopt.</p></div>
        <div class="blok"><h3>Overstappers</h3><p>Je hebt al een boekhouder, maar mist contact, snelheid of overzicht. Overstappen kan midden in het jaar, ik regel de overdracht.</p></div>
        <div class="blok"><h3>Starters</h3><p>Je begint net. Ik richt alles goed in, zodat je vanaf je eerste factuur op orde bent.</p></div>
        <div class="blok"><h3>Vof met twee of meer</h3><p>Eén administratie voor de vof, met de winstverdeling per vennoot in je jaarcijfers.</p></div>
      </div>
    </div>
  </section>

  <section class="zacht">
    <div class="wrap twee">
      <div>
        <h2>Wat je krijgt</h2>
        <ul class="vinkjes">
          <li>Je boekhouding in Moneybird, doorlopend bijgewerkt en voor elke btw-aangifte door mij gecontroleerd</li>
          <li>De btw-aangifte, op tijd ingediend. Je hoort vooraf wat je aan de Belastingdienst betaalt</li>
          <li>Je jaarcijfers, klaar voor je aangifte inkomstenbelasting</li>
          <li>Vragen tussendoor via WhatsApp of mail, zonder dat de meter loopt</li>
          <li>Slim op WhatsApp voor facturen, offertes en bonnetjes</li>
        </ul>
        <p class="sub">Je aangifte inkomstenbelasting doe ik ook, voor €245. Was je het hele jaar klant, dan met 15% korting. <a href="/aangifte-inkomstenbelasting">Meer over de aangifte IB</a></p>
      </div>
      <SlimGesprek />
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>Zo werkt het</h2>
      <div class="grid3">
        <div class="blok"><div class="nr">1</div><h3>Je meldt je aan</h3><p>Laat je gegevens achter of stuur een WhatsApp. Je hoort binnen een tot drie werkdagen van me.</p></div>
        <div class="blok"><div class="nr">2</div><h3>Ik richt alles in</h3><p>Ik zet Moneybird en Slim voor je klaar. Je bank koppel je zelf met een paar klikken, ik vertel je precies waar.</p></div>
        <div class="blok"><div class="nr">3</div><h3>Jij appt, ik boek</h3><p>Ik doe de aangiftes en laat je vooraf weten wat je aan de Belastingdienst moet betalen.</p></div>
      </div>
    </div>
  </section>

  <section class="zacht">
    <div class="wrap">
      <GoogleReviews eerst={['Daan van der Mark', 'Dany Cramer', 'Mirte Groen', 'Jeremy Gomes']} />
    </div>
  </section>

  <Faq vragen={faq} />
  <Contactblok />
</Basis>

<style>
.sub a{color:var(--blauw)}
@media (min-width:760px) and (max-width:1099px){.grid3.vier{grid-template-columns:repeat(2,1fr)}}
@media (min-width:1100px){.grid3.vier{grid-template-columns:repeat(4,1fr)}}
</style>

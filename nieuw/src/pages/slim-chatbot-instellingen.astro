---
// Slim-aanmelding stap 2: factuurinstellingen. Overgenomen van de React-site
// (src/components/SlimChatbotInstellingen.tsx), met de fix uit PR #44: e-mail en
// telefoon uit stap 1 (sessionStorage 'slim-aanmelding') gaan mee als 'email' en
// 'telefoon', zodat n8n (workflow 0mVaHSHxOxVOlSdC, webhook slim-instellingen) de
// instellingen aan de juiste aanmelding koppelt. Het btw-nummer is niet verplicht
// (ondernemers in de KOR hebben er geen op hun factuur nodig).
// Zelfde Netlify-formulier "slim-chatbot-instellingen" en dezelfde veldnamen.
import Basis from '../layouts/Basis.astro';
import '../styles/formulier.css';
const sjablonen = [['template1', 'Professioneel grijs', '/img/slim/template-1.png'], ['template2', 'Accent geel', '/img/slim/template-2.png'], ['template3', 'Modern blauw', '/img/slim/template-3.png']];
---
<Basis titel="Slim instellen, stap 2 | Slim Geregeld Administratie" omschrijving="Factuurinstellingen voor Slim, de WhatsApp-assistent van Slim Geregeld." robots="noindex, nofollow" cta="/slim#aanmelden">
  <section class="si-kop">
    <div class="wrap">
      <span class="tag">Stap 2 van 2</span>
      <h1>Je factuurinstellingen</h1>
      <p class="sub">Deze gegevens komen automatisch op je facturen en offertes. Alles is later nog aan te passen.</p>
    </div>
  </section>
  <section style="padding-top:0">
    <div class="wrap" style="max-width:820px;margin-left:max(20px,calc((100% - 1160px)/2 + 20px))">
      <form class="aanmeld-form" id="slim-stap2" name="slim-chatbot-instellingen" method="POST" data-netlify="true" data-netlify-honeypot="bot-field">
        <input type="hidden" name="form-name" value="slim-chatbot-instellingen">
        <input type="hidden" name="email" id="si-email">
        <input type="hidden" name="telefoon" id="si-telefoon">
        <p style="display:none"><label>Laat dit leeg: <input name="bot-field"></label></p>
        <p class="bij" id="si-wie" hidden></p>

        <h3>Bedrijfsgegevens</h3>
        <label>Zakelijke website <span class="opt">optioneel</span><input name="website" type="text" placeholder="https://jouwbedrijf.nl"></label>
        <div class="rij">
          <label>KVK-nummer<input name="kvkNummer" type="text" inputmode="numeric" required placeholder="12345678"></label>
          <label>Btw-nummer <span class="opt">optioneel</span><input name="btwNummer" type="text" placeholder="NL123456789B01"><small>Leeg laten als je in de KOR zit of geen btw rekent.</small></label>
        </div>
        <div class="rij">
          <label>IBAN<input name="iban" type="text" required autocomplete="off" placeholder="NL91 ABNA 0417 1643 00"></label>
          <label>Rekening op naam van<input name="rekeningTnv" type="text" required placeholder="Jouw bedrijfsnaam"></label>
        </div>
        <label>Adres<input name="adres" type="text" required autocomplete="street-address" placeholder="Straatnaam 123"></label>
        <div class="rij">
          <label>Postcode<input name="postcode" type="text" required autocomplete="postal-code" placeholder="1234 AB"></label>
          <label>Plaats<input name="plaats" type="text" required autocomplete="address-level2" placeholder="Amsterdam"></label>
        </div>

        <h3>Factuurinstellingen</h3>
        <div class="rij">
          <label>Betalingstermijn<select name="betalingstermijn" required><option value="7">7 dagen</option><option value="14" selected>14 dagen</option><option value="30">30 dagen</option></select></label>
          <label>Geldigheid offertes<select name="geldigheidOffertes" required><option value="14">14 dagen</option><option value="30" selected>30 dagen</option><option value="60">60 dagen</option></select></label>
        </div>
        <label>Prijzen<select name="prijzenInclBtw" required><option value="excl" selected>Exclusief btw</option><option value="incl">Inclusief btw</option></select></label>

        <h3>Opmaak</h3>
        <div class="sjablonen" role="radiogroup" aria-label="Opmaak van je facturen">
          {sjablonen.map(([id, naam, img], i) => (
            <label class="sjabloon"><input type="radio" name="template" value={id} checked={i === 0}><img src={img} alt="" width="300" height="424" loading="lazy">{naam}</label>
          ))}
        </div>

        <h3>Eigen teksten <span class="opt">optioneel</span></h3>
        <label>Betalingsvoorwaarden op je factuur<textarea name="betalingsvoorwaarden" placeholder="Bijvoorbeeld: Wij verzoeken u vriendelijk het totale bedrag binnen 14 dagen over te maken onder vermelding van het factuurnummer."></textarea></label>
        <label>Tekst boven de offerte<textarea name="offerteTekstBoven" placeholder="Bijvoorbeeld: Hierbij ontvangt u de prijsopgave voor de onderstaande diensten."></textarea></label>
        <label>Tekst onder de offerte<textarea name="offerteTekstOnder" placeholder="Bijvoorbeeld: We hopen u hiermee voldoende geïnformeerd te hebben."></textarea></label>
        <label>Nog iets wat je kwijt wilt?<textarea name="extraOpmerkingen" placeholder="Bijzondere wensen voor je facturen, vragen over Slim, alles."></textarea></label>

        <button class="knop vol" type="submit">Opslaan en activeren</button>
        <p class="fout" id="si-fout" hidden>Dat lukte niet. Probeer het opnieuw of stuur een WhatsApp naar 06 21311043.</p>
      </form>
      <div class="si-klaar" id="si-klaar" hidden>
        <h2>Dank je, je instellingen zijn opgeslagen</h2>
        <p class="sub">Binnen 24 uur krijg je een WhatsApp-bericht van Slim om te starten.</p>
        <a class="knop leeg" href="/slim">Terug naar Slim</a>
      </div>
    </div>
  </section>
</Basis>

<script is:inline>
(function () {
  var f = document.getElementById('slim-stap2');
  // E-mail en telefoon uit stap 1. Zonder (privévenster, of rechtstreeks hier
  // binnengekomen) koppelt n8n aan de enige aanmelding van het afgelopen uur.
  var a = {};
  try { a = JSON.parse(sessionStorage.getItem('slim-aanmelding') || '{}') || {}; } catch (e) {}
  document.getElementById('si-email').value = a.email || '';
  document.getElementById('si-telefoon').value = a.telefoon || '';
  if (a.email) { var w = document.getElementById('si-wie'); w.textContent = 'Voor ' + a.email + (a.telefoon ? ', ' + a.telefoon : '') + '.'; w.hidden = false; }
  f.addEventListener('submit', function (e) {
    e.preventDefault();
    if (!f.checkValidity()) { f.reportValidity(); return; }
    var knop = f.querySelector('button[type=submit]'); knop.disabled = true; knop.textContent = 'Even geduld...';
    fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(new FormData(f)).toString() })
      .then(function (r) {
        if (!r.ok) throw new Error('http ' + r.status);
        (window.dataLayer = window.dataLayer || []).push({ event: 'formulier_verstuurd', formulier: 'slim-stap2' });
        try { sessionStorage.removeItem('slim-aanmelding'); } catch (e) {}
        f.hidden = true; document.getElementById('si-klaar').hidden = false; window.scrollTo({ top: 0 });
      })
      .catch(function () { knop.disabled = false; knop.textContent = 'Opslaan en activeren'; document.getElementById('si-fout').hidden = false; });
  });
})();
</script>

<style>
.si-kop{padding:28px 0 20px;background:linear-gradient(180deg,var(--blauw-t),#fff 85%)}
.si-kop .sub{margin-top:12px}
.si-klaar{border:1px solid var(--lijn);border-radius:var(--r-groot);padding:28px;background:#fff}
.si-klaar .knop{margin-top:16px}
</style>

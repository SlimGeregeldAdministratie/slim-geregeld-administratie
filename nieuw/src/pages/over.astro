---
import Basis from '../layouts/Basis.astro';
import Paginakop from '../components/Paginakop.astro';
import GoogleReviews from '../components/GoogleReviews.astro';
import Contactblok from '../components/Contactblok.astro';

const persoon = {
  '@context': 'https://schema.org', '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person', name: 'Kyle Bouwmeester', jobTitle: 'Boekhouder',
    worksFor: { '@type': 'AccountingService', name: 'Slim Geregeld Administratie', url: 'https://slim-geregeld.nl/' },
    sameAs: ['https://www.linkedin.com/in/kylebouwmeester'],
    hasCredential: { '@type': 'EducationalOccupationalCredential', credentialCategory: 'Registratie', name: 'Becon-geregistreerd boekhouder' },
  },
};
---
<Basis
  titel="Over Kyle Bouwmeester, boekhouder | Slim Geregeld"
  omschrijving="Kyle Bouwmeester is Becon-geregistreerd boekhouder en Moneybird Expert. Hij helpt zzp'ers en kleine bv's vanuit Amsterdam en de Zaanstreek."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(persoon)} />
  <Paginakop
    kruimel="Over mij"
    tag="Over mij"
    titel="Hoi, ik ben Kyle"
    groet
    sub="Becon-geregistreerd boekhouder en Moneybird Expert. Ik help zzp'ers en kleine bv's door heel Nederland met hun administratie, vanuit Amsterdam en de Zaanstreek."
    foto={{ src: '/img/kyle-1.jpg', alt: 'Kyle Bouwmeester op de bank met zijn laptop', pos: '50% 40%' }}
  />

  <section>
    <div class="wrap">
      <div class="feiten">
        <div><b>Becon</b><span>geregistreerd boekhouder</span></div>
        <div><b>Moneybird</b><span>Expert-kantoor</span></div>
        <div><b>Heel Nederland</b><span>vanuit Amsterdam en de Zaanstreek</span></div>
        <div><b>NL en EN</b><span>beide talen</span></div>
      </div>
      <div class="twee boven verhaal">
        <div class="lees">
          <h2>Waarom ik dit ben gestart</h2>
          <p>Mijn oude huisgenoot werkte zes jaar als zzp'er in de bouw. Elk kwartaal zat hij vlak voor de deadline van de btw-aangifte twee nachten aan de keukentafel, met overal papier, en kwam hij er niet uit. Ik dacht: dat moet veel slimmer kunnen.</p>
          <p>Met mijn achtergrond in finance en in automatisering en AI ben ik eind 2024 Slim Geregeld begonnen. Het herhaalwerk heb ik zo veel mogelijk geautomatiseerd. Daardoor heb ik tijd voor wat telt: je cijfers controleren en meedenken.</p>
        </div>
        <div class="lees">
          <h2>Hoe ik werk</h2>
          <p>Mijn belangrijkste doel: jou ontzorgen. Jij doet waar je goed in bent, ik zorg dat je administratie klopt en dat je niet verrast wordt door de Belastingdienst.</p>
          <ul>
            <li>Eén vaste boekhouder: je appt of mailt mij, en je krijgt antwoord van mij.</li>
            <li>Alles in Moneybird, op jouw naam. Je houdt altijd zelf toegang.</li>
            <li>Vaste prijzen, vooraf bekend.</li>
            <li>Bijna alles via WhatsApp, mail of telefoon. Elkaar zien kan ook, in Amsterdam of de Zaanstreek.</li>
            <li>In het Nederlands en het Engels, ook voor ondernemers uit de VS en Japan.</li>
          </ul>
          <p><a href="https://www.linkedin.com/in/kylebouwmeester" target="_blank" rel="noopener">Volg me op LinkedIn ↗</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="zacht">
    <div class="wrap">
      <GoogleReviews />
    </div>
  </section>

  <Contactblok titel="Kennismaken?" tekst="Vertel kort wat je hebt en waar je mee zit. Je hoort binnen een tot drie werkdagen van me." />
</Basis>

<style>
.boven{align-items:start}
.feiten{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:8px}
.verhaal .lees :global(h2){margin-top:28px}
@media (min-width:760px){.feiten{grid-template-columns:repeat(4,1fr)}}
.feiten div{background:var(--zacht);border-radius:12px;padding:14px}
.feiten b{display:block;font-size:1.05rem}
.feiten span{font-size:.85rem;color:var(--grijs)}
</style>

n   \"@type\": \"WebSite\",\n   \"@id\": \"https://slim-geregeld.nl/#website\",\n   \"url\": \"https://slim-geregeld.nl/\",\n   \"name\": \"Slim Geregeld\",\n   \"publisher\": {\n    \"@id\": \"https://slim-geregeld.nl/#org\"\n   }\n  },\n  {\n   \"@type\": \"WebPage\",\n   \"@id\": \"https://slim-geregeld.nl/djtt/ja/#webpage\",\n   \"url\": \"https://slim-geregeld.nl/djtt/ja/\",\n   \"name\": \"日蘭通商航海条約（DJTT）の開業貸借対照表\",\n   \"description\": \"日蘭通商航海条約（IND申請目的510）でオランダの個人事業主の滞在許可を申請する日本国籍の方のための、Becon登録簿記士による署名付き開業貸借対照表。やり取りは英語です。\",\n   \"inLanguage\": \"ja\",\n   \"isPartOf\": {\n    \"@id\": \"https://slim-geregeld.nl/#website\"\n   },\n   \"publisher\": {\n    \"@id\": \"https://slim-geregeld.nl/#org\"\n   },\n   \"breadcrumb\": {\n    \"@id\": \"https://slim-geregeld.nl/djtt/ja/#breadcrumb\"\n   },\n   \"dateModified\": \"2026-11-18\",\n   \"primaryImageOfPage\": \"https://slim-geregeld.nl/slim-geregeld-preview.jpg\",\n   \"author\": {\n    \"@id\": \"https://slim-geregeld.nl/#kyle\"\n   },\n   \"mainEntity\": {\n    \"@id\": \"https://slim-geregeld.nl/djtt/ja/#service\"\n   }\n  },\n  {\n   \"@type\": \"BreadcrumbList\",\n   \"@id\": \"https://slim-geregeld.nl/djtt/ja/#breadcrumb\",\n   \"itemListElement\": [\n    {\n     \"@type\": \"ListItem\",\n     \"position\": 1,\n     \"name\": \"Slim Geregeld\",\n     \"item\": \"https://slim-geregeld.nl/\"\n    },\n    {\n     \"@type\": \"ListItem\",\n     \"position\": 2,\n     \"name\": \"DJTT\",\n     \"item\": \"https://slim-geregeld.nl/djtt/\"\n    },\n    {\n     \"@type\": \"ListItem\",\n     \"position\": 3,\n     \"name\": \"日本語\",\n     \"item\": \"https://slim-geregeld.nl/djtt/ja/\"\n    }\n   ]\n  },\n  {\n   \"@type\": \"Service\",\n   \"@id\": \"https://slim-geregeld.nl/djtt/ja/#service\",\n   \"name\": \"日蘭通商航海条約（DJTT）の開業貸借対照表\",\n   \"serviceType\": \"日蘭通商航海条約による滞在許可のための署名付き開業貸借対照表\",\n   \"description\": \"日蘭通商航海条約（IND申請目的510）でオランダの個人事業主の滞在許可を申請する日本国籍の方のための、Becon登録簿記士による署名付き開業貸借対照表。やり取りは英語です。\",\n   \"provider\": {\n    \"@id\": \"https://slim-geregeld.nl/#org\"\n   },\n   \"areaServed\": {\n    \"@type\": \"Country\",\n    \"name\": \"Netherlands\"\n   },\n   \"availableChannel\": {\"@type\": \"ServiceChannel\", \"serviceUrl\": \"https://slim-geregeld.nl/djtt/ja/\", \"availableLanguage\": \"en\"},\n   \"audience\": {\n    \"@type\": \"Audience\",\n    \"audienceType\": \"日蘭通商航海条約（IND申請目的510）でオランダの個人事業主の滞在許可を申請する日本国籍の方\"\n   },\n   \"offers\": [\n    {\n     \"@type\": \"Offer\",\n     \"name\": \"スタンダード\",\n     \"price\": \"495\",\n     \"priceCurrency\": \"EUR\",\n     \"description\": \"5営業日以内に署名済み開業貸借対照表、税抜\",\n     \"availability\": \"https://schema.org/InStock\",\n     \"priceSpecification\": {\n      \"@type\": \"PriceSpecification\",\n      \"price\": \"495\",\n      \"priceCurrency\": \"EUR\",\n      \"valueAddedTaxIncluded\": false\n     }\n    },\n    {\n     \"@type\": \"Offer\",\n     \"name\": \"優先\",\n     \"price\": \"595\",\n     \"priceCurrency\": \"EUR\",\n     \"description\": \"48時間以内に署名済み開業貸借対照表、税抜\",\n     \"availability\": \"https://schema.org/InStock\",\n     \"priceSpecification\": {\n      \"@type\": \"PriceSpecification\",\n      \"price\": \"595\",\n      \"priceCurrency\": \"EUR\",\n      \"valueAddedTaxIncluded\": false\n     }\n    },\n    {\n     \"@type\": \"Offer\",\n     \"name\": \"Compliance Plan\",\n     \"price\": \"79\",\n     \"priceCurrency\": \"EUR\",\n     \"description\": \"Monthly bookkeeping for an eenmanszaak or VOF, €79 or €149 a month excluding VAT, minimum 12 months, balance sheet and renewal statement included\",\n     \"priceSpecification\": {\n      \"@type\": \"UnitPriceSpecification\",\n      \"price\": \"79\",\n      \"priceCurrency\": \"EUR\",\n      \"unitCode\": \"MON\",\n      \"valueAddedTaxIncluded\": false\n     }\n    }\n   ],\n   \"url\": \"https://slim-geregeld.nl/djtt/ja/\"\n  },\n  {\n   \"@type\": \"FAQPage\",\n   \"@id\": \"https://slim-geregeld.nl/djtt/ja/#faq\",\n   \"inLanguage\": \"ja\",\n   \"isPartOf\": {\n    \"@id\": \"https://slim-geregeld.nl/djtt/ja/#webpage\"\n   },\n   \"mainEntity\": [\n    {\n     \"@type\": \"Question\",\n     \"name\": \"初回申請に開業貸借対照表は必要ですか？\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"申請書7524には記載されています。他の滞在許可から変更する場合は、申請と一緒に提出します。海外からの初回申請では、INDは2024年4月以降、開業貸借対照表なしで申請を許可し、KVK登録、事業用口座の開設、出資のために6か月の期間を与えています。その後INDが証明を求めることがあり、署名付きの開業貸借対照表がその証明になります。最初から書類をそろえるために提出する方も多くいます。\"\n     }\n    },\n    {\n     \"@type\": \"Question\",\n     \"name\": \"4,500ユーロは銀行残高のことですか？\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"最も多い誤解です。INDが求めているのは、貸借対照表上の4,500ユーロの自己資本であり、銀行口座に4,500ユーロがあることとは同じではありません。自己資本とは、事業に出資した額から事業の負債を差し引いたものです。だからこそ、簿記士が書類を作成し、自己資本が実際に存在することを専門家として表明する必要があります。\"\n     }\n    },\n    {\n     \"@type\": \"Question\",\n     \"name\": \"日本の条約はDAFTと同じ仕組みですか？\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"はい。日本国籍の方は、日蘭通商航海条約の最恵国待遇条項により、DAFTのアメリカ人と同じ待遇を受けます。INDの申請書では申請目的510（DAFTは453）にあたり、要件も同じです。ポイント制の審査はなく、4,500ユーロの自己資本と、資格を持つ専門家が確認・署名した貸借対照表が必要です。開業貸借対照表はどちらのルートでも同じ書類です。\"\n     }\n    },\n    {\n     \"@type\": \"Question\",\n     \"name\": \"日本語でやり取りできますか？\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"このページは日本語でご案内していますが、お申し込みフォーム、メール、書類、お問い合わせへの回答はすべて英語で行います。貸借対照表そのものはオランダ語と英語の併記です。\"\n     }\n    },\n    {\n     \"@type\": \"Question\",\n     \"name\": \"資金が借入金の場合はどうなりますか？\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"借りたお金は負債であり自己資本ではないため、借入金に基づく貸借対照表はINDの要件を満たしません。よくあるケースで、多くの場合は解決できます。たとえば、借入金の代わりに貯蓄を使う方法などです。フォームでお知らせいただければ、資金を動かす前に選択肢をご説明します。\"\n     }\n    },\n    {\n     \"@type\": \"Question\",\n     \"name\": \"貸借対照表に署名できるのは誰ですか？\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"INDの申請書は「資格を持つ独立した外部の専門家」を求め、registeraccountant、accountant-administratieconsulent、簿記士（boekhouder）、ファイナンシャルアドバイザーを挙げています。簿記士は明記されているため、高額な公認会計士に依頼する必要はありません。「独立した」「外部の」という点が重要で、ご本人、パートナー、ご家族は署名できません。Slim Geregeldはオランダ税務当局に登録された外部の事務所です。\"\n     }\n    },\n    {\n     \"@type\": \"Question\",\n     \"name\": \"どれくらいで受け取れますか？\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"お支払いと書類が揃ってから、通常は5営業日で納品します。INDの面談が迫っている場合は、優先オプションで48時間以内に納品します。\"\n     }\n    },\n    {\n     \"@type\": \"Question\",\n     \"name\": \"料金に付加価値税は含まれますか？\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"状況によって異なります。オランダで事業登録が済んでいれば事業者としてのご依頼となり、請求書に21%の付加価値税がかかりますが、最初の付加価値税申告で還付を受けられるため、実質的な費用は495ユーロです。事業登録前で、まだEU域外にお住まいの場合、このようなサービスには通常オランダの付加価値税はかかりません。すでにオランダにお住まいで未登録の場合は付加価値税がかかります。お支払い前に書面で確認します。\"\n     }\n    },\n    {\n     \"@type\": \"Question\",\n     \"name\": \"4,500ユーロを入金する前に依頼できますか？\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"はい、お申し込みは入金前でも可能です。ただし、貸借対照表は実際の状況を反映する必要があるため、最終版への署名は入金後になります。その間に書類を準備し、入金が確認でき次第、署名済みのPDFをお送りします。\"\n     }\n    },\n    {\n     \"@type\": \"Question\",\n     \"name\": \"事務所に行く必要はありますか？\",\n     \"acceptedAnswer\": {\n      \"@type\": \"Answer\",\n      \"text\": \"いいえ。フォームの送信、メールでの書類送付、PDFでの受け取りまで、すべてオンラインで完結します。オランダ国内からでも海外からでもご利用いただけます。\"\n     }\n    }\n   ]\n  }\n ]\n}"} />

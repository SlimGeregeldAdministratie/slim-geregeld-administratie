---
import Basis from '../layouts/Basis.astro';
---
<Basis
  titel="Bedankt voor je bericht | Slim Geregeld"
  omschrijving="Je bericht is binnen. Je krijgt binnen een tot drie werkdagen antwoord."
  robots="noindex, follow"
  cta="/contact"
>
  <section class="dank">
    <div class="wrap">
      <img class="foto" src="/img/kyle-profiel.jpg" alt="Kyle Bouwmeester" width="88" height="88">
      <h1>Bedankt, je bericht is binnen</h1>
      <p class="sub">Je krijgt binnen een tot drie werkdagen antwoord van mij, meestal al dezelfde dag. Haast? Stuur me gerust even een WhatsApp.</p>
      <div class="knoppen">
        <a class="knop wa" href="https://wa.me/31621311043" target="_blank" rel="noopener">Stuur een WhatsApp</a>
        <a class="knop leeg" href="/">Terug naar de homepage</a>
      </div>
    </div>
  </section>
</Basis>

<script is:inline>
  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ event: 'formulier_verstuurd', formulier: 'contact' });
</script>

<style>
.dank{padding:64px 0 80px;text-align:center;background:linear-gradient(180deg,var(--blauw-t),#fff 75%)}
.foto{width:88px;height:88px;border-radius:50%;object-fit:cover;margin:0 auto 18px;box-shadow:var(--schaduw)}
.sub{margin:14px auto 24px}
.knoppen{justify-content:center}
</style>

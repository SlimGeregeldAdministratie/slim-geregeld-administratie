   n8n blijft werken. Kop, voet en meting komen uit Basis. */
import Basis from '../../../layouts/Basis.astro';
import '../../../styles/verdrag/renewal.css';
import '../../../styles/verdrag.css';
import inhoud from '../../../inhoud/renewal.html?raw';

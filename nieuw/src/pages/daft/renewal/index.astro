const [voor, rest] = inhoud.split('<!--SCORES-->');
const [midden, na] = rest.split('<!--REVIEWS-->');
---
<Basis
  titel="DAFT Renewal in the Netherlands from €495 | Slim Geregeld"
  omschrijving="Renewing a DAFT or DJTT permit? The IND wants signed figures for last year and this year so far. From €495, by a Becon-registered bookkeeper."

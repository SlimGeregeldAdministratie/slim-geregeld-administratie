---
// Slim-aanmelding stap 2: factuurinstellingen, in het Nederlands
// (/slim-chatbot-instellingen) en Engels (/en/slim/settings/). Overgenomen van
// de React-site, met de fix uit PR #44: e-mail en telefoon uit stap 1
// (sessionStorage 'slim-aanmelding') gaan mee als 'email' en 'telefoon', zodat
// n8n (workflow 0mVaHSHxOxVOlSdC, webhook slim-instellingen) de instellingen aan
// de juiste aanmelding koppelt. Het btw-nummer is niet verplicht (KOR).
// Zelfde Netlify-formulier "slim-chatbot-instellingen" en dezelfde veldnamen;
// 'template' is template1 tot en met template6 (src/lib/factuur.mjs, dezelfde
// code als de pdf in n8n). Verborgen veld 'taal': nl of en.
import Basis from '../layouts/Basis.astro';
import '../styles/formulier.css';
import { SJABLONEN } from '../lib/factuur.mjs';

interface Props { taal?: 'nl' | 'en' }
const { taal = 'nl' } = Astro.props;
const en = taal === 'en';
const T = en ? { opt: "optional", adres: "Address", postcode: "Postcode", plaats: "City", eigen: "Your own texts", stap: "Step 2 of 2", kop: "Your invoice settings", sub: "These details go on your invoices and quotes. On the right you see straight away what that looks like. You can change everything later through Slim.", hBedrijf: "Your business", web: "Business website", kvk: "KvK number", btw: "VAT number", btwUitleg: "Leave empty if you use the small business scheme (KOR) or don't charge VAT.", tnv: "Account holder name", tnvPh: "Your business name", adresPh: "Street name 123", hAfspraken: "Terms on your invoices", termijn: "Payment term", geldig: "Quotes valid for", prijzen: "Your prices are", excl: "Excluding VAT (usual for business clients)", incl: "Including VAT (usual for consumers)", hOpmaak: "Layout", opmaakLabel: "Layout of your invoices", bekijk: "See the preview", uitleg1: "Leave these empty and Slim uses the standard text you see in the preview now. Want something else? Type it here and the preview updates straight away. Use", uitleg2: "for your client's name.", voorw: "Payment terms on your invoice", voorwPh: "Please transfer the amount within 14 days to your IBAN in the name of your business, quoting the invoice number.", boven: "Text above your quote", bovenPh: "Dear {naam}, please find below our quote for the work described.", onder: "Text below your quote", onderPh: "We trust this is clear and look forward to your approval.", extra: "Anything else you want to tell me?", extraPh: "Special wishes for your invoices, questions about Slim, anything.", extraUitleg: "This doesn't go on your invoice, it's for me.", opslaan: "Save and activate", fout: "That didn't work. Please try again or send a WhatsApp to +31 6 21311043.", klaarKop: "Thanks, your settings are saved", klaarSub: "Within 24 hours you get a WhatsApp message from Slim to get started.", terug: "Back to Slim", vbLabel: "Preview of your invoice", fac: "Invoice", off: "Quote", noot: "Example with a made-up client and lines. This is what your PDF looks like.", dagen: "days", titel: "Set up Slim, step 2 | Slim Geregeld", omschrijving: "Invoice settings for Slim, the WhatsApp assistant of Slim Geregeld." } : { opt: "optioneel", adres: "Adres", postcode: "Postcode", plaats: "Plaats", eigen: "Eigen teksten", stap: "Stap 2 van 2", kop: "Je factuurinstellingen", sub: "Deze gegevens komen op je facturen en offertes. Rechts zie je meteen hoe dat eruitziet. Alles is later nog aan te passen via Slim.", hBedrijf: "Je bedrijf", web: "Zakelijke website", kvk: "KVK-nummer", btw: "Btw-nummer", btwUitleg: "Leeg laten als je in de KOR zit of geen btw rekent.", tnv: "Rekening op naam van", tnvPh: "Jouw bedrijfsnaam", adresPh: "Straatnaam 123", hAfspraken: "Afspraken op je facturen", termijn: "Betalingstermijn", geldig: "Geldigheid offertes", prijzen: "Je prijzen zijn", excl: "Exclusief btw (meestal bij zakelijke klanten)", incl: "Inclusief btw (meestal bij particulieren)", hOpmaak: "Opmaak", opmaakLabel: "Opmaak van je facturen", bekijk: "Bekijk het voorbeeld", uitleg1: "Laat je deze leeg, dan zet Slim er de standaardtekst op die je nu in het voorbeeld ziet. Wil je iets anders, typ het dan hier; het voorbeeld past zich meteen aan. Gebruik", uitleg2: "voor de naam van je klant.", voorw: "Betalingsvoorwaarden op je factuur", voorwPh: "Wij verzoeken u vriendelijk het bedrag binnen 14 dagen over te maken op je IBAN ten name van je bedrijf, onder vermelding van het factuurnummer.", boven: "Tekst boven je offerte", bovenPh: "Geachte {naam}, hierbij ontvangt u de prijsopgave voor de onderstaande werkzaamheden.", onder: "Tekst onder je offerte", onderPh: "We hopen u hiermee voldoende te hebben geïnformeerd en horen graag of u akkoord gaat.", extra: "Nog iets wat je kwijt wilt?", extraPh: "Bijzondere wensen voor je facturen, vragen over Slim, alles.", extraUitleg: "Dit komt niet op je factuur, het is voor mij.", opslaan: "Opslaan en activeren", fout: "Dat lukte niet. Probeer het opnieuw of stuur een WhatsApp naar 06 21311043.", klaarKop: "Dank je, je instellingen zijn opgeslagen", klaarSub: "Binnen 24 uur krijg je een WhatsApp-bericht van Slim om te starten.", terug: "Terug naar Slim", vbLabel: "Voorbeeld van je factuur", fac: "Factuur", off: "Offerte", noot: "Voorbeeld met een verzonnen klant en regels. Zo ziet je pdf eruit.", dagen: "dagen", titel: "Slim instellen, stap 2 | Slim Geregeld Administratie", omschrijving: "Factuurinstellingen voor Slim, de WhatsApp-assistent van Slim Geregeld." };
---
<Basis titel={T.titel} omschrijving={T.omschrijving} robots="noindex, nofollow" taal={taal} alternatief={{ nl: '/slim-chatbot-instellingen/', en: '/en/slim/settings/' }} cta={en ? '/en/slim/#aanmelden' : '/slim#aanmelden'}>
  <section class="si-kop">
    <div class="wrap">
      <span class="tag">{T.stap}</span>
      <h1>{T.kop}</h1>
      <p class="sub">{T.sub}</p>
    </div>
  </section>
  <section style="padding-top:0">
    <div class="wrap si-raster">
      <div>
        <form class="aanmeld-form" id="slim-stap2" data-taal={taal} name="slim-chatbot-instellingen" method="POST" data-netlify="true" data-netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="slim-chatbot-instellingen">
          <input type="hidden" name="taal" value={taal}>
          <input type="hidden" name="email" id="si-email">
          <input type="hidden" name="telefoon" id="si-telefoon">
          <p style="display:none"><label>Laat dit leeg: <input name="bot-field"></label></p>
          <p class="bij" id="si-wie" hidden></p>

          <h3>{T.hBedrijf}</h3>
          <label>{T.web} <span class="opt">{T.opt}</span><input name="website" type="text" placeholder="jouwbedrijf.nl"></label>
          <div class="rij">
            <label>{T.kvk}<input name="kvkNummer" type="text" inputmode="numeric" required placeholder="12345678"></label>
            <label>{T.btw} <span class="opt">{T.opt}</span><input name="btwNummer" type="text" placeholder="NL123456789B01"><small>{T.btwUitleg}</small></label>
          </div>
          <div class="rij">
            <label>IBAN<input name="iban" type="text" required autocomplete="off" placeholder="NL91 ABNA 0417 1643 00"></label>
            <label>{T.tnv}<input name="rekeningTnv" type="text" required placeholder={T.tnvPh}></label>
          </div>
          <label>{T.adres}<input name="adres" type="text" required autocomplete="street-address" placeholder={T.adresPh}></label>
          <div class="rij">
            <label>{T.postcode}<input name="postcode" type="text" required autocomplete="postal-code" placeholder="1234 AB"></label>
            <label>{T.plaats}<input name="plaats" type="text" required autocomplete="address-level2" placeholder="Amsterdam"></label>
          </div>

          <h3>{T.hAfspraken}</h3>
          <div class="rij">
            <label>{T.termijn}<select name="betalingstermijn" required><option value="7">7 {T.dagen}</option><option value="14" selected>14 {T.dagen}</option><option value="30">30 {T.dagen}</option></select></label>
            <label>{T.geldig}<select name="geldigheidOffertes" required><option value="14">14 {T.dagen}</option><option value="30" selected>30 {T.dagen}</option><option value="60">60 {T.dagen}</option></select></label>
          </div>
          <label>{T.prijzen}<select name="prijzenInclBtw" required><option value="excl" selected>{T.excl}</option><option value="incl">{T.incl}</option></select></label>

          <h3>{T.hOpmaak}</h3>
          <div class="sjablonen" role="radiogroup" aria-label={T.opmaakLabel}>
            {SJABLONEN.map((s) => (
              <label class="sjabloon"><input type="radio" name="template" value={'template' + s.nr} checked={s.nr === 1}><img src={`/img/slim/sjabloon-${s.nr}${en ? "-en" : ""}.png`} alt="" width="368" height="520" loading="lazy"><b>{en ? s.naamEn : s.naam}</b><small>{en ? s.uitlegEn : s.uitleg}</small></label>
            ))}
          </div>

          <a class="naar-voorbeeld" href="#si-voorbeeld">{T.bekijk}</a>
          <h3>{T.eigen} <span class="opt">{T.opt}</span></h3>
          <p class="uitleg-tekst">{T.uitleg1} <code>{'{naam}'}</code> {T.uitleg2}</p>
          <label>{T.voorw}<textarea name="betalingsvoorwaarden" data-voor="factuur" placeholder={T.voorwPh}></textarea></label>
          <label>{T.boven}<textarea name="offerteTekstBoven" data-voor="offerte" placeholder={T.bovenPh}></textarea></label>
          <label>{T.onder}<textarea name="offerteTekstOnder" data-voor="offerte" placeholder={T.onderPh}></textarea></label>
          <label>{T.extra} <span class="opt">{T.opt}</span><textarea name="extraOpmerkingen" placeholder={T.extraPh}></textarea><small>{T.extraUitleg}</small></label>

          <button class="knop vol" type="submit">{T.opslaan}</button>
          <p class="fout" id="si-fout" hidden>{T.fout}</p>
        </form>
        <div class="si-klaar" id="si-klaar" hidden>
          <h2>{T.klaarKop}</h2>
          <p class="sub">{T.klaarSub}</p>
          <a class="knop leeg" href={en ? '/en/slim/' : '/slim'}>{T.terug}</a>
        </div>
      </div>

      <aside class="si-voorbeeld" id="si-voorbeeld" aria-label={T.vbLabel}>
        <div class="si-wissel" role="tablist">
          <button type="button" data-soort="factuur" aria-pressed="true">{T.fac}</button>
          <button type="button" data-soort="offerte" aria-pressed="false">{T.off}</button>
        </div>
        <div class="si-papier"><iframe id="si-frame" title={T.vbLabel} tabindex="-1"></iframe></div>
        <p class="si-noot">{T.noot}</p>
      </aside>
    </div>
  </section>
</Basis>

<script>
import { factuurHtml } from '../lib/factuur.mjs';
const EN = document.getElementById('slim-stap2')?.dataset.taal === 'en';
const f = document.getElementById('slim-stap2') as HTMLFormElement;
const frame = document.getElementById('si-frame') as HTMLIFrameElement;
let soort = 'factuur';

// E-mail en telefoon uit stap 1. Zonder (privévenster, of rechtstreeks hier
// binnengekomen) koppelt n8n aan de enige aanmelding van het afgelopen uur.
let a: any = {};
try { a = JSON.parse(sessionStorage.getItem('slim-aanmelding') || '{}') || {}; } catch (e) {}
(document.getElementById('si-email') as HTMLInputElement).value = a.email || '';
(document.getElementById('si-telefoon') as HTMLInputElement).value = a.telefoon || '';
if (a.email) { const w = document.getElementById('si-wie')!; w.textContent = (EN ? 'For ' : 'Voor ') + a.email + (a.telefoon ? ', ' + a.telefoon : '') + '.'; w.hidden = false; }

const v = (n: string) => ((f.elements.namedItem(n) as HTMLInputElement | null)?.value || '').trim();
const plusDagen = (n: number) => { const d = new Date(); d.setDate(d.getDate() + n); return d.toISOString().slice(0, 10); };

function teken() {
  const termijn = Number(v('betalingstermijn')) || 14;
  const sjabloon = Number((v('template') || (f.querySelector('input[name=template]:checked') as HTMLInputElement)?.value || 'template1').replace(/\D/g, '')) || 1;
  const bedrijf = a.bedrijfsnaam || (EN ? 'Your business' : 'Jouw bedrijf');
  const data = {
    taal: EN ? 'en' : 'nl', soort, nummer: soort === 'offerte' ? 'OF-2026-001' : '2026-001', datum: plusDagen(0),
    verval: plusDagen(termijn), geldigTot: plusDagen(Number(v('geldigheidOffertes')) || 30), termijn,
    inclBtw: v('prijzenInclBtw') === 'incl',
    van: { bedrijf, adres: v('adres') || (EN ? 'Street name 123' : 'Straatnaam 123'), postcode: v('postcode') || '1234 AB', plaats: v('plaats') || (EN ? 'City' : 'Plaats'), email: a.email || '', tel: a.telefoon || '', web: v('website'), kvk: v('kvkNummer') || '12345678', btw: v('btwNummer'), iban: v('iban') || 'NL00 BANK 0123 4567 89', tnv: v('rekeningTnv') || bedrijf },
    aan: { bedrijf: EN ? 'Example Client B.V.' : 'Voorbeeldklant B.V.', naam: 'Sam de Vries', adres: 'Kerkstraat 1', postcode: '1011 AB', plaats: 'Amsterdam' },
    regels: [{ omschrijving: EN ? 'Work as agreed' : 'Werkzaamheden volgens afspraak', aantal: 8, prijs: 65, btw: v('btwNummer') ? 21 : 0 }, { omschrijving: EN ? 'Materials' : 'Materiaal', aantal: 1, prijs: 120, btw: v('btwNummer') ? 21 : 0 }],
    voorwaarden: v('betalingsvoorwaarden'), tekstBoven: v('offerteTekstBoven'), tekstOnder: v('offerteTekstOnder'),
  };
  frame.srcdoc = factuurHtml(data, sjabloon);
  f.querySelectorAll<HTMLElement>('textarea[data-voor]').forEach((t) => t.closest('label')!.classList.toggle('si-ander', t.dataset.voor !== soort));
}
let wacht: number | undefined;
f.addEventListener('input', () => { clearTimeout(wacht); wacht = window.setTimeout(teken, 150); });
f.addEventListener('change', teken);
document.querySelectorAll<HTMLButtonElement>('.si-wissel button').forEach((b) => b.addEventListener('click', () => {
  soort = b.dataset.soort!;
  document.querySelectorAll('.si-wissel button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  teken();
}));
// Wie in een offertetekst klikt, ziet meteen de offerte.
f.querySelectorAll<HTMLTextAreaElement>('textarea[data-voor]').forEach((t) => t.addEventListener('focus', () => {
  if (t.dataset.voor !== soort) (document.querySelector(`.si-wissel [data-soort=${t.dataset.voor}]`) as HTMLButtonElement).click();
}));
teken();

// Het A4-blad (794 px breed) verkleinen tot de breedte van het vak.
const papier = frame.parentElement!;
const schaal = () => { frame.style.transform = 'scale(' + (papier.clientWidth / 794) + ')'; };
new ResizeObserver(schaal).observe(papier); schaal();

f.addEventListener('submit', (e) => {
  e.preventDefault();
  if (!f.checkValidity()) return;
  const knop = f.querySelector('button[type=submit]') as HTMLButtonElement; knop.disabled = true; knop.textContent = EN ? 'One moment...' : 'Even geduld...';
  const data = new FormData(f);
  // Op de lokale preview bestaat Netlify Forms niet: daar alleen het bedankblok tonen.
  const lokaal = /^(localhost|127\.0\.0\.1)$/.test(location.hostname);
  (lokaal ? Promise.resolve({ ok: true, status: 200 }) : fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(data as any).toString() }))
    .then((r) => {
      if (!r.ok) throw new Error('http ' + r.status);
      ((window as any).dataLayer = (window as any).dataLayer || []).push({ event: 'formulier_verstuurd', formulier: 'slim-stap2' });
      try { sessionStorage.removeItem('slim-aanmelding'); } catch (e) {}
      f.hidden = true; document.getElementById('si-klaar')!.hidden = false; window.scrollTo({ top: 0 });
    })
    .catch(() => { knop.disabled = false; knop.textContent = EN ? 'Save and activate' : 'Opslaan en activeren'; document.getElementById('si-fout')!.hidden = false; });
});
</script>

<style>
.si-kop{padding:28px 0 20px;background:linear-gradient(180deg,var(--blauw-t),#fff 85%)}
.si-kop .sub{margin-top:12px;max-width:42rem}
.si-raster{display:grid;gap:28px;align-items:start}
.si-klaar{border:1px solid var(--lijn);border-radius:var(--r-groot);padding:28px;background:#fff}
.si-klaar .knop{margin-top:16px}
.si-voorbeeld{display:grid;gap:10px}
.si-wissel{display:inline-flex;gap:4px;background:var(--zacht);border:1px solid var(--lijn);border-radius:999px;padding:3px;justify-self:start}
.si-wissel button{font:inherit;font-size:.88rem;font-weight:650;border:0;background:none;color:var(--grijs);border-radius:999px;padding:6px 14px;cursor:pointer}
.si-wissel button[aria-pressed="true"]{background:#fff;color:var(--inkt);box-shadow:0 1px 3px rgba(15,23,42,.12)}
/* A4 (210 x 297 mm = 794 x 1123 px) verkleind in een vak dat meeschaalt */
.si-papier{position:relative;width:100%;aspect-ratio:210/297;border:1px solid var(--lijn);border-radius:10px;overflow:hidden;background:#fff;box-shadow:0 14px 40px rgba(15,23,42,.10)}
.si-papier iframe{position:absolute;left:0;top:0;width:794px;height:1123px;border:0;transform-origin:0 0}
.si-noot{font-size:.84rem;color:var(--grijs)}
.uitleg-tekst{font-size:.9rem;color:var(--tekst);margin-top:-4px}
.uitleg-tekst code{background:var(--zacht);border-radius:5px;padding:1px 5px;font-size:.88em}
.si-ander{opacity:.55}
.naar-voorbeeld{font-size:.88rem;color:var(--blauw);font-weight:650;text-decoration:none}
@media (max-width:999px){.si-voorbeeld{order:-1;scroll-margin-top:80px}.si-papier{max-width:420px}}
@media (min-width:1000px){.naar-voorbeeld{display:none}}
@media (min-width:1000px){
  .si-raster{grid-template-columns:minmax(0,1fr) 400px;gap:40px}
  .si-voorbeeld{position:sticky;top:96px}
}
</style>

---
// Slim-pagina in het Nederlands (/slim) en Engels (/en/slim/). Aanmelden voor
// alleen Slim: stap 1 hieronder (#aanmelden), stap 2 op /slim-chatbot-instellingen
// of /en/slim/settings/. Zelfde Netlify-formulieren en veldnamen in beide talen;
// het verborgen veld 'taal' vertelt n8n in welke taal Slim de klant aanspreekt.
import Basis from '../layouts/Basis.astro';
import Paginakop from './Paginakop.astro';
import SlimGesprek from './SlimGesprek.astro';
import GoogleReviews from './GoogleReviews.astro';
import Faq from './Faq.astro';
import Contactblok from './Contactblok.astro';
import { LANDEN } from '../lib/landen.mjs';
import '../styles/formulier.css';

interface Props { taal?: 'nl' | 'en' }
const { taal = 'nl' } = Astro.props;
const en = taal === 'en';
const AANMELDEN = '#aanmelden';
type Msg = [string, string, string];

const T = en ? {
  titel: 'Slim: invoices and receipts via WhatsApp | Slim Geregeld',
  omschrijving: 'Slim is your bookkeeping assistant on WhatsApp: create invoices and quotes, book receipts with a photo and ask about your own numbers. First six months free.',
  kruimel: 'Slim on WhatsApp', tag: 'Slim on WhatsApp',
  kop: 'Run your admin straight from WhatsApp',
  sub: 'Slim is your bookkeeping assistant on WhatsApp. Send a photo of a receipt, ask for an invoice or ask who still owes you money. Slim sorts it, and I keep an eye on it.',
  prijs: { bedrag: 'Free', per: 'for the first six months', uitleg: 'then €9.95 per month · included with full bookkeeping' },
  knop: 'Try Slim',
  watTitel: 'What Slim does for you', watSub: 'Tap a card to see what it looks like.', kijk: 'See an example', vb: 'Example',
  functies: [
    { titel: 'Invoices and quotes', tekst: 'Say who, what and how much. Slim creates the invoice or quote, shows it to you and only sends it after your OK.',
      chat: [['mij', '', 'Quote for Studio Noord, logo design €850'], ['slim', 'pdf', 'Quote 2026-018.pdf|€850.00 + €178.50 VAT|Shall I send it?|Send|Edit'], ['mij', '', 'Make it €800'], ['slim', 'knop', 'Changed to €800.00. Send?|Send|Edit']] },
    { titel: 'Receipts', tekst: 'Take a photo or send a PDF. Slim reads it and adds it to your books, with the VAT split out.',
      chat: [['mij', 'foto', 'Receipt Shell'], ['slim', '', 'Booked: €78.40 fuel, of which €13.61 VAT you get back.']] },
    { titel: 'Voice messages', tekst: 'Don\'t feel like typing? Record your invoice or question. Slim turns it into text and gets to work.',
      chat: [['mij', 'spraak', '0:05|Invoice Studio Noord, eight hours at 65 euros.'], ['slim', 'pdf', 'Invoice 2026-041.pdf|8 hours × €65.00, total €629.20|Shall I send it?|Send|Edit']] },
    { titel: 'Adding clients', tekst: 'Give the KvK number and Slim looks up the name and address itself.',
      chat: [['mij', '', 'New client, KvK 12345678'], ['slim', 'knop', '👤 Bakkerij De Wit, Dorpsstraat 12, Zaandam. Add?|Yes, add|No']] },
    { titel: 'Your own numbers', tekst: 'Ask what is still outstanding, what your revenue is or which quotes are still open.',
      chat: [['mij', '', 'What is my revenue this quarter?'], ['slim', '', '📊 This quarter so far: €14,250.00 revenue and €3,120.40 costs.']] },
    { titel: 'Payments and reminders', tekst: 'Who still owes you? Slim tells you, and sends a reminder after your OK.',
      chat: [['mij', '', 'Who still owes me money?'], ['slim', 'knop', '💶 Bakkerij De Wit, €302.50, 14 days late. Send a reminder?|Send reminder|Cancel'], ['mij', '', 'Send reminder'], ['slim', '', '📨 Reminder sent.']] },
  ] as { titel: string; tekst: string; chat: Msg[] }[],
  controleTitel: 'Slim types, I check',
  controleSub: 'Slim takes the typing off your hands, but your books are not a vending machine. With full bookkeeping I keep an eye on things all year, and before every VAT return I check your books myself. If something is off, or a booking fits better elsewhere, you hear it from me.',
  controle: ['Nothing goes out without your OK', 'If Slim doesn\'t know, your question comes to me', 'Before every VAT return I check everything myself', 'One bookkeeper who knows your business'],
  waaromTitel: 'Why WhatsApp?',
  waarom: [['No new app', 'You already have WhatsApp. No login, no password, no software to learn.'], ['Right away, wherever you are', 'An invoice after the job, a receipt at the till. You sort it on the spot instead of on Sunday night.'], ['With or without Moneybird', 'With Moneybird, everything you send goes straight into your books. Without Moneybird, Slim keeps its own overview for you.']],
  losTitel: 'Slim on its own or with a bookkeeper',
  losSub: 'Slim also works if you do your own bookkeeping. If you want me to take over later, Slim is simply included in full bookkeeping.',
  los: [['Slim only', 'First six months free', 'Then €9.95 per month. Also without Moneybird.', 'Try Slim →', AANMELDEN], ['Full bookkeeping', 'From €79 per month', 'Your books, VAT returns and annual figures, in English, with Slim included.', 'See pricing →', '/en/pricing/']],
  stap: 'Step 1 of 2', aanTitel: 'Try Slim',
  aanSub: 'Fill in your basic details. In step 2 you choose what your invoices look like. Within 24 hours you get a WhatsApp message to get started.',
  aanVink: ['First six months free, then €9.95 per month', 'Also without Moneybird', 'No strings attached'],
  voornaam: 'First name', achternaam: 'Last name', bedrijf: 'Business name', email: 'Email address', emailPh: 'you@email.com',
  tel: 'Mobile number with WhatsApp', telPh: '6 12345678', telUitleg: 'This is the number Slim connects to.', land: 'Country code',
  verder: 'Continue to step 2', wacht: 'One moment...',
  fout: 'That didn\'t work. Please try again or send a WhatsApp to +31 6 21311043.',
  stap2: '/en/slim/settings/',
  faqTitel: 'Frequently asked questions',
  faq: [
    ['What does Slim cost?', 'Slim is included with full bookkeeping. If you only use Slim, the first six months are free and then it is €9.95 per month. No strings attached.'],
    ['Do I need Moneybird?', 'No, Slim also works without Moneybird. Your invoices and quotes then go into a separate overview. With Moneybird, Slim puts everything straight into your books.'],
    ['Does Slim send invoices on its own?', 'No. Slim always shows you the invoice first. Only when you tap send does it go out. Reminders are also only sent after your OK.'],
    ['Can Slim handle voice messages?', 'Yes. Record your invoice or question, Slim turns it into text and gets to work.'],
    ['What if Slim doesn\'t know?', 'Then Slim says so honestly and passes your question on to me. I take a look and reply myself.'],
    ['Does Slim work in English?', 'Yes. Slim works in English and in Dutch. Your invoices can be in English too.'],
  ] as [string, string][],
  ctTitel: 'Questions about Slim?', ctTekst: 'Want to know first whether Slim suits you? Leave your details or send a WhatsApp, and you hear from me within one to three working days.',
} : {
  titel: 'Slim: facturen en bonnetjes via WhatsApp | Slim Geregeld',
  omschrijving: 'Slim is je boekhoudassistent op WhatsApp: facturen en offertes maken, bonnetjes boeken met een foto en vragen over je eigen cijfers. Eerste halfjaar gratis.',
  kruimel: 'Slim op WhatsApp', tag: 'Slim op WhatsApp',
  kop: 'Je administratie regel je gewoon in WhatsApp',
  sub: 'Slim is je boekhoudassistent op WhatsApp. Stuur een foto van een bonnetje, vraag om een factuur of vraag wie je nog moet betalen. Slim regelt het, en ik kijk mee.',
  prijs: { bedrag: 'Gratis', per: 'het eerste halfjaar', uitleg: 'daarna €9,95 per maand · bij de volledige service zit Slim erbij' },
  knop: 'Probeer Slim',
  watTitel: 'Wat Slim voor je doet', watSub: 'Tik op een kaart en zie hoe het eruitziet.', kijk: 'Bekijk een voorbeeld', vb: 'Voorbeeld',
  functies: [
    { titel: 'Facturen en offertes', tekst: 'Zeg voor wie, wat en hoeveel. Slim maakt de factuur of offerte, laat hem zien en verstuurt hem pas na jouw akkoord.',
      chat: [['mij', '', 'Offerte voor Studio Noord, logo-ontwerp €850'], ['slim', 'pdf', 'Offerte 2026-018.pdf|€850,00 + €178,50 btw|Zal ik hem versturen?|Versturen|Aanpassen'], ['mij', '', 'Maak er €800 van'], ['slim', 'knop', 'Aangepast naar €800,00. Versturen?|Versturen|Aanpassen']] },
    { titel: 'Bonnetjes', tekst: 'Maak een foto of stuur een pdf. Slim leest hem en zet hem in je administratie, met de btw apart.',
      chat: [['mij', 'foto', 'Bonnetje Shell'], ['slim', '', 'Geboekt: €78,40 brandstof, waarvan €13,61 btw die je terugkrijgt.']] },
    { titel: 'Inspreken', tekst: 'Geen zin om te typen? Spreek je factuur of vraag in. Slim zet het om in tekst en gaat ermee aan de slag.',
      chat: [['mij', 'spraak', '0:05|Factuur Studio Noord, acht uur à 65 euro.'], ['slim', 'pdf', 'Factuur 2026-041.pdf|8 uur × €65,00, totaal €629,20|Zal ik hem versturen?|Versturen|Aanpassen']] },
    { titel: 'Klanten toevoegen', tekst: 'Noem het KvK-nummer en Slim haalt de naam en het adres zelf op.',
      chat: [['mij', '', 'Nieuwe klant, KvK 12345678'], ['slim', 'knop', '👤 Bakkerij De Wit, Dorpsstraat 12, Zaandam. Toevoegen?|Ja, toevoegen|Nee']] },
    { titel: 'Je eigen cijfers', tekst: 'Vraag wat er nog openstaat, wat je omzet is of welke offertes nog lopen.',
      chat: [['mij', '', 'Hoeveel omzet heb ik dit kwartaal?'], ['slim', '', '📊 Dit kwartaal tot nu toe: €14.250,00 omzet en €3.120,40 inkoop.']] },
    { titel: 'Betalingen en herinneringen', tekst: 'Wie moet je nog betalen? Slim zegt het je, en stuurt na jouw akkoord een herinnering.',
      chat: [['mij', '', 'Wie moet mij nog betalen?'], ['slim', 'knop', '💶 Bakkerij De Wit, €302,50, 14 dagen te laat. Herinnering sturen?|Verstuur herinnering|Annuleren'], ['mij', '', 'Verstuur herinnering'], ['slim', '', '📨 Herinnering verstuurd.']] },
  ] as { titel: string; tekst: string; chat: Msg[] }[],
  controleTitel: 'Slim typt, ik controleer',
  controleSub: 'Slim neemt je het typwerk uit handen, maar je administratie is geen automaat. Bij de volledige service kijk ik doorlopend mee, en voor elke btw-aangifte controleer ik je boekhouding zelf. Klopt er iets niet, of past een boeking beter ergens anders, dan hoor je het van mij.',
  controle: ['Niets gaat de deur uit zonder jouw akkoord', 'Weet Slim iets niet, dan komt je vraag bij mij', 'Voor elke btw-aangifte controleer ik alles zelf', 'Je hebt één vaste boekhouder die meekijkt'],
  waaromTitel: 'Waarom via WhatsApp?',
  waarom: [['Geen nieuwe app', 'WhatsApp heb je al. Geen inlog, geen wachtwoord, geen programma leren.'], ['Direct, waar je ook bent', 'Een factuur na de klus, een bonnetje bij de kassa. Je regelt het meteen, in plaats van op zondagavond.'], ['Met of zonder Moneybird', 'Met Moneybird komt alles wat je appt direct in je administratie. Zonder Moneybird houdt Slim een eigen overzicht voor je bij.']],
  losTitel: 'Slim los of met boekhouder',
  losSub: 'Slim werkt ook als je je boekhouding zelf doet. Wil je dat ik het daarna van je overneem, dan zit Slim gewoon bij de volledige service.',
  los: [['Alleen Slim', 'Eerste halfjaar gratis', 'Daarna €9,95 per maand. Ook zonder Moneybird.', 'Probeer Slim →', AANMELDEN], ['Volledige service', '€95 per maand', 'Je boekhouding, btw-aangiftes en jaarcijfers, met Slim erbij.', 'Meer over de volledige service →', '/boekhouding-eenmanszaak']],
  stap: 'Stap 1 van 2', aanTitel: 'Probeer Slim',
  aanSub: 'Vul je basisgegevens in. In stap 2 kies je hoe je facturen eruitzien. Binnen 24 uur krijg je een WhatsApp-bericht om te starten.',
  aanVink: ['Eerste halfjaar gratis, daarna €9,95 per maand', 'Ook zonder Moneybird', 'Je zit nergens aan vast'],
  voornaam: 'Voornaam', achternaam: 'Achternaam', bedrijf: 'Bedrijfsnaam', email: 'E-mailadres', emailPh: 'je@email.nl',
  tel: 'Mobiel nummer met WhatsApp', telPh: '6 12345678', telUitleg: 'Hierop koppelen we Slim.', land: 'Landcode',
  verder: 'Naar stap 2', wacht: 'Even geduld...',
  fout: 'Dat lukte niet. Probeer het opnieuw of stuur een WhatsApp naar 06 21311043.',
  stap2: '/slim-chatbot-instellingen/',
  faqTitel: 'Veelgestelde vragen',
  faq: [
    ['Wat kost Slim?', 'Bij de volledige service zit Slim erbij. Gebruik je alleen Slim, dan is het eerste halfjaar gratis en daarna €9,95 per maand. Je zit nergens aan vast.'],
    ['Heb ik Moneybird nodig?', 'Nee, Slim werkt ook zonder Moneybird. Je facturen en offertes komen dan in een eigen overzicht. Met Moneybird zet Slim alles direct in je administratie.'],
    ['Verstuurt Slim zomaar facturen?', 'Nee. Slim laat je altijd eerst de factuur zien. Pas als je op versturen tikt, gaat hij de deur uit. Herinneringen gaan ook pas na jouw akkoord.'],
    ['Kan Slim ook spraakberichten aan?', 'Ja. Spreek je factuur of vraag in, Slim zet het om in tekst en gaat ermee aan de slag.'],
    ['Wat als Slim het niet weet?', 'Dan zegt Slim dat eerlijk en zet hij je vraag door naar mij. Ik kijk mee en reageer zelf.'],
    ['Werkt Slim ook in het Engels?', 'Ja. Slim werkt in het Nederlands en in het Engels.'],
  ] as [string, string][],
  ctTitel: 'Vragen over Slim?', ctTekst: 'Wil je eerst weten of Slim bij je past? Laat je gegevens achter of stuur een WhatsApp, dan hoor je het binnen een tot drie werkdagen.',
};
const golf = [4,9,6,12,8,14,7,11,5,13,9,6,10,4,8,12,6,9];
---
<Basis titel={T.titel} omschrijving={T.omschrijving} taal={taal} alternatief={{ nl: '/slim', en: '/en/slim/' }} cta={en ? AANMELDEN : undefined}>
  <Paginakop taal={taal} kruimel={T.kruimel} tag={T.tag} titel={T.kop} sub={T.sub} prijs={T.prijs} knop={[T.knop, AANMELDEN]} wa={false}>
    <SlimGesprek slot="rechts" taal={taal} />
  </Paginakop>

  <section>
    <div class="wrap">
      <h2>{T.watTitel}</h2>
      <p class="sub">{T.watSub}</p>
      <div class="functies">
        {T.functies.map((f) => (
          <details class="functie">
            <summary><h3>{f.titel}</h3><p>{f.tekst}</p><span class="kijk">{T.kijk}</span></summary>
            <div class="mini" aria-label={`${T.vb}: ${f.titel}`}>
              {f.chat.map(([wie, soort, t]) => {
                const d = t.split('|');
                if (soort === 'foto') return <span class={`mb ${wie} foto`}><span class="bonfoto" aria-hidden="true"><i></i></span>{t}</span>;
                if (soort === 'spraak') return <span class={`mb ${wie}`}><span class="speler" aria-hidden="true"><i class="play"></i><span class="golf">{golf.map((h) => <span style={`height:${h}px`} />)}</span><small>{d[0]}</small></span><em class="uit">{d[1]}</em></span>;
                if (soort === 'pdf') return <span class={`mb ${wie} met-knop`}><span class="bestand"><i>PDF</i><span><b>{d[0]}</b><small>{d[1]}</small></span></span><span class="mt">{d[2]}</span>{d.slice(3).map((k) => <span class="wk">{k}</span>)}</span>;
                if (soort === 'knop') return <span class={`mb ${wie} met-knop`}><span class="mt">{d[0]}</span>{d.slice(1).map((k) => <span class="wk">{k}</span>)}</span>;
                return <span class={`mb ${wie}`}>{t}</span>;
              })}
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="zacht">
    <div class="wrap twee onder">
      <div>
        <h2>{T.controleTitel}</h2>
        <p class="sub">{T.controleSub}</p>
      </div>
      <ul class="vinkjes">{T.controle.map((x) => <li>{x}</li>)}</ul>
    </div>
  </section>

  <section>
    <div class="wrap">
      <h2>{T.waaromTitel}</h2>
      <div class="grid3">{T.waarom.map(([h, p]) => <div class="blok"><h3>{h}</h3><p>{p}</p></div>)}</div>
    </div>
  </section>

  <section class="zacht">
    <div class="wrap">
      <h2>{T.losTitel}</h2>
      <p class="sub">{T.losSub}</p>
      <div class="keus">{T.los.map(([h, pr, p, l, href]) => <div class="blok"><h3>{h}</h3><p class="pr">{pr}</p><p>{p}</p><a class="meer" href={href}>{l}</a></div>)}</div>
    </div>
  </section>

  <section id="aanmelden">
    <div class="wrap twee aanmeld">
      <div>
        <span class="tag">{T.stap}</span>
        <h2>{T.aanTitel}</h2>
        <p class="sub">{T.aanSub}</p>
        <ul class="vinkjes">{T.aanVink.map((x) => <li>{x}</li>)}</ul>
      </div>
      <form class="aanmeld-form" id="slim-stap1" name="slim-chatbot-basisgegevens" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" data-stap2={T.stap2} data-verder={T.verder} data-wacht={T.wacht}>
        <input type="hidden" name="form-name" value="slim-chatbot-basisgegevens">
        <input type="hidden" name="taal" value={taal}>
        <input type="hidden" name="telefoon" id="slim-telefoon">
        <p style="display:none"><label>Laat dit leeg: <input name="bot-field"></label></p>
        <div class="rij"><label>{T.voornaam}<input name="voornaam" type="text" required autocomplete="given-name"></label>
          <label>{T.achternaam}<input name="achternaam" type="text" required autocomplete="family-name"></label></div>
        <label>{T.bedrijf}<input name="bedrijfsnaam" type="text" required autocomplete="organization"></label>
        <label>{T.email}<input name="email" type="email" required autocomplete="email" placeholder={T.emailPh}></label>
        <div class="tel-veld"><label for="slim-nummer">{T.tel}</label>
        <div class="tel-rij">
          <select id="slim-landcode" aria-label={T.land} autocomplete="tel-country-code">{LANDEN.map(([c, n, e]) => <option value={c} selected={c === '+31'}>{en ? e : n} ({c})</option>)}</select>
          <input id="slim-nummer" type="tel" required autocomplete="tel-national" inputmode="tel" placeholder={T.telPh}>
        </div>
        <small class="tel-uitleg">{T.telUitleg}</small></div>
        <button class="knop vol" type="submit">{T.verder}</button>
        <p class="fout" id="slim-fout" hidden>{T.fout}</p>
      </form>
    </div>
  </section>

  <section>
    <div class="wrap">
      <GoogleReviews taal={taal} eerst={['Daan van der Mark', 'Jeremy Gomes', 'Burak Sahin', 'Umesh ten Kate']} />
    </div>
  </section>

  <Faq vragen={T.faq} titel={T.faqTitel} />
  <Contactblok taal={taal} titel={T.ctTitel} tekst={T.ctTekst} />
  <script is:inline>
  (function(){
    var f = document.getElementById('slim-stap1'); if (!f) return;
    var land = document.getElementById('slim-landcode'), nr = document.getElementById('slim-nummer'), tel = document.getElementById('slim-telefoon');
    // Landcode plus nummer zonder voorloopnul: +31 en 06 12345678 wordt +31612345678.
    function zetTel(){ var n = nr.value.replace(/[^0-9]/g, '').replace(/^0+/, ''); tel.value = n ? land.value + n : ''; }
    land.addEventListener('change', zetTel); nr.addEventListener('input', zetTel);
    f.addEventListener('submit', function(e){
      e.preventDefault(); zetTel();
      if (!f.checkValidity()) { f.reportValidity(); return; }
      var knop = f.querySelector('button'); knop.disabled = true; knop.textContent = f.dataset.wacht;
      // Stap 2 stuurt e-mail en telefoon mee, zodat n8n (slim-instellingen) de
      // factuurinstellingen aan deze aanmelding koppelt (zelfde fix als PR #44).
      try { sessionStorage.setItem('slim-aanmelding', JSON.stringify({ email: f.email.value.trim(), telefoon: tel.value, bedrijfsnaam: f.bedrijfsnaam.value.trim() })); } catch (x) {}
      function klaar(){ (window.dataLayer = window.dataLayer || []).push({ event: 'formulier_verstuurd', formulier: 'slim-stap1' }); location.href = f.dataset.stap2; }
      // Op de lokale preview bestaat Netlify Forms niet: daar alleen doorklikken.
      if (/^(localhost|127\.0\.0\.1)$/.test(location.hostname)) { console.info('Lokale preview: formulier niet verstuurd'); klaar(); return; }
      fetch('/', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(new FormData(f)).toString() })
        .then(function(r){ if (!r.ok) throw new Error('http ' + r.status); klaar(); })
        .catch(function(){ knop.disabled = false; knop.textContent = f.dataset.verder; document.getElementById('slim-fout').hidden = false; });
    });
  })();
  </script>
  <script is:inline>
  /* Dichtgeklapte functiekaarten even hoog per rij. */
  (function(){
    function gelijk(){
      var k=[].slice.call(document.querySelectorAll('.functie summary'));
      k.forEach(function(s){s.style.minHeight='';});
      var rijen={};
      k.forEach(function(s){var t=Math.round(s.parentNode.offsetTop);(rijen[t]=rijen[t]||[]).push(s);});
      Object.keys(rijen).forEach(function(t){var m=Math.max.apply(null,rijen[t].map(function(s){return s.offsetHeight;}));rijen[t].forEach(function(s){s.style.minHeight=m+'px';});});
    }
    gelijk(); addEventListener('resize',gelijk);
  })();
  </script>
</Basis>

<style>
/* Lijst onderaan gelijk met de tekst links (Kyle 23-11-2026) */
.twee.onder{align-items:end}
.twee.onder .vinkjes{margin-bottom:0}
.tel-rij{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:8px}
.tel-rij select{min-width:0}
.tel-veld .tel-rij{margin-top:6px}
.tel-uitleg{display:block;margin-top:4px;font-weight:400;color:var(--grijs);font-size:.84rem}
.keus{display:grid;gap:14px;margin-top:22px}
.pr{color:var(--blauw);font-weight:700}
.functies{display:grid;gap:14px;margin-top:22px;align-items:start}
.functie{border:1px solid var(--lijn);border-radius:var(--r);background:#fff;transition:border-color .15s,box-shadow .15s}
.functie:hover{border-color:var(--blauw-rand);box-shadow:0 8px 24px rgba(37,99,235,.08)}
.functie[open]{border-color:var(--blauw-rand)}
.functie summary{list-style:none;cursor:pointer;padding:22px;display:flex;flex-direction:column}
.functie summary .kijk{margin-top:auto;padding-top:12px}
.functie summary::-webkit-details-marker{display:none}
.functie p{color:var(--grijs);margin-top:6px}
.kijk{display:inline-block;color:var(--blauw);font-weight:650;font-size:.92rem}
.kijk::after{content:" ↓"}
.functie[open] .kijk::after{content:" ↑"}
.mini{display:flex;flex-direction:column;gap:6px;background:#efeae2;margin:0 12px 12px;padding:12px;border-radius:12px;font-size:.86rem;line-height:1.4}

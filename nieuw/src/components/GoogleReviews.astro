---
import { google, reviews } from '../data/reviews';
interface Props { taal?: 'nl' | 'en'; titel?: string }
const { taal = 'nl', titel } = Astro.props;
const T = taal === 'en'
  ? { titel: 'What clients say', reviews: 'reviews on Google', alle: 'See all reviews on Google', op: 'View on Google' }
  : { titel: 'Wat klanten zeggen', reviews: 'reviews op Google', alle: 'Bekijk alle reviews op Google', op: 'Bekijk op Google' };
const lijst = reviews.filter((r) => r.taal === taal || taal === 'nl');
const sterren = (n: number) => '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n);
const G = `<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>`;
---
<div class="gr">
  <div class="gr-kop">
    <h2>{titel ?? T.titel}</h2>
    <a class="score" href={google.profiel} target="_blank" rel="noopener">
      <span class="g" set:html={G} />
      <span class="cijfer">{google.score}</span>
      <span class="ster" aria-hidden="true">★★★★★</span>
      <span class="aantal">{google.aantal} {T.reviews}</span>
    </a>
  </div>
  <div class="gr-lijst">
    {lijst.map((r) => (
      <figure class="kaart">
        <div class="wie">
          {r.foto ? <img src={r.foto} alt="" width="44" height="44" loading="lazy"> : <span class="init">{r.naam[0]}</span>}
          <div><b>{r.naam}</b><small>{r.wat}</small></div>
          <span class="g klein" set:html={G} />
        </div>
        <div class="st" aria-label={`${r.sterren} van 5 sterren`}>{sterren(r.sterren)}</div>
        <blockquote>{r.tekst}</blockquote>
        {r.link && <a class="op" href={r.link} target="_blank" rel="noopener">{T.op} ↗</a>}
      </figure>
    ))}
  </div>
  <a class="alle knop leeg" href={google.profiel} target="_blank" rel="noopener"><span set:html={G} />{T.alle}</a>
</div>

<style>
.gr-kop{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px}
.gr-kop h2{margin:0}
.score{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--lijn);border-radius:999px;padding:8px 14px;text-decoration:none;box-shadow:0 4px 14px rgba(15,23,42,.05)}
.score .cijfer{font-weight:800;font-size:1.15rem}
.score .ster{color:#f5a524;letter-spacing:1px}
.score .aantal{color:var(--grijs);font-size:.9rem}
.g{display:inline-flex}
.gr-lijst{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;padding:4px 2px 10px;margin-top:22px;-webkit-overflow-scrolling:touch}
.kaart{flex:0 0 84%;scroll-snap-align:start;background:#fff;border:1px solid var(--lijn);border-radius:var(--r);padding:18px;display:flex;flex-direction:column;gap:10px}
.wie{display:flex;align-items:center;gap:10px}
.wie img,.init{width:44px;height:44px;border-radius:50%;object-fit:cover;flex:none}
.init{display:grid;place-items:center;background:var(--blauw-t);color:var(--blauw);font-weight:700}
.wie div{flex:1;min-width:0}
.wie b{display:block;font-size:.95rem}
.wie small{color:var(--grijs);font-size:.8rem}
.st{color:#f5a524;letter-spacing:2px;font-size:.9rem}
blockquote{color:var(--tekst);font-size:.97rem;flex:1}
.op{color:var(--blauw);text-decoration:none;font-size:.85rem;font-weight:600}
.alle{margin-top:18px}
@media (min-width:760px){
  .gr-lijst{display:grid;grid-template-columns:repeat(4,1fr);overflow:visible}
  .kaart{flex:auto}
}
</style>

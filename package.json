{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/seo-paginas.mjs",
    "test:blog": "node scripts/test-blog.mjs",
    "blog:check": "node -e \"import('./scripts/blog.mjs').then(({leesBlogs,leesNieuws})=>{const b=leesBlogs(),n=leesNieuws(),f=[...b.fouten,...n.fouten];b.waarschuwingen.forEach(w=>console.warn('let op: '+w));f.forEach(x=>console.error('fout: '+x));console.log(b.stukken.length+' blogs, '+n.items.length+' nieuwsposts');process.exit(f.length?1:0)})\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "marked": "18.1.1",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",

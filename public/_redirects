# Eén canonieke host: www en http gaan in één stap naar https://slim-geregeld.nl.
http://www.slim-geregeld.nl/*   https://slim-geregeld.nl/:splat   301!
https://www.slim-geregeld.nl/*  https://slim-geregeld.nl/:splat   301!
http://slim-geregeld.nl/*       https://slim-geregeld.nl/:splat   301!

# Schone deelbare URLs voor de DAFT-pagina.
/daft/request     /daft/#request     301
/daft/request/    /daft/#request     301
/daft/pricing     /daft/#pricing     301
/daft/faq         /daft/#faq         301

# DJTT (Japans verdrag, doel 510) en de verlenging als eigen aanbod. /djft is de
# eerdere werknaam en stuurt door, net als /daft/japan.
/djtt/request     /djtt/#request     301
/djtt/request/    /djtt/#request     301
/djtt/pricing     /djtt/#pricing     301
/djtt/faq         /djtt/#faq         301
/djft             /djtt/             301
/djft/*           /djtt/:splat       301
/daft/japan       /djtt/             301
/daft/japan/      /djtt/             301
/daft/renewal/request    /daft/renewal/#request    301
/daft/renewal/pricing    /daft/renewal/#pricing    301
/renewal          /daft/renewal/     301
/renewal/         /daft/renewal/     301

# Meetlinks in de DAFT-mails. /start/<naam> gaat via n8n, dat de klik logt en
# daarna doorstuurt naar het aanvraagformulier. Zo staat er een eigen domein in
# de mail in plaats van een webhook-URL.
/start/*   https://n8n.slim-geregeld.nl/webhook/daft-start?r=:splat&m=2   302!


# Schone deelbare URLs voor de DAFT-pagina. Deze moeten boven de catch-all staan,
# want die vangt anders alles op naar de React-app.
/daft/request     /daft/#request     301
/daft/request/    /daft/#request     301
/daft/pricing     /daft/#pricing     301
/daft/faq         /daft/#faq         301

# Meetlinks in de DAFT-mails. /start/<naam> gaat via n8n, dat de klik logt en
# daarna doorstuurt naar het aanvraagformulier. Zo staat er een eigen domein in
# de mail in plaats van een webhook-URL.
/start/*   https://n8n.slim-geregeld.nl/webhook/daft-start?r=:splat&m=2   302!

# Klantportaal. De code achter /portal/ is per klant en staat in de sheet; de
# pagina leest hem uit de URL en haalt daarmee zijn eigen gegevens op bij n8n.
# 200 en niet 301, want de code moet in de adresbalk blijven staan.
/portal/*  /portal/index.html  200

/bedankt       /index.html   200
/sitemap.xml   /sitemap.xml  200
/favicon.png   /favicon.png  200
/*             /index.html   200
